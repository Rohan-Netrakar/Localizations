  <script src="/socket.io/socket.io.js"></script>
  <style>
    /* ═══════════════════════════════════════════════════════════════════
   IndoorLocate  ·  Floor Map  ·  style.css
   ─────────────────────────────────────────────────────────────────
   Complete, standalone stylesheet — link as:
     <link rel="stylesheet" href="/css/style.css">
   then remove the inline <style> block from localizations.ejs
   ─────────────────────────────────────────────────────────────────
   BUGS FIXED vs previous version
   ✓  --corridor   alias added  (HTML inline: background:var(--corridor))
   ✓  --mono        alias added  (HTML inline: font-family:var(--mono))
   ✓  --accent      alias added  (HTML inline: color:var(--accent))
   ✓  East-corridor strip colour resolved
   ✓  All z-index layers correctly stacked
   ═══════════════════════════════════════════════════════════════════
   TABLE OF CONTENTS
   01  Reset
   02  Design Tokens  (:root variables)
   03  Base  (html, body)
   04  Navbar
   05  Live Pill
   06  Nav Buttons
   07  Topbar
   08  Search Bar & Dropdown
   09  Stats Row
   10  Feature Toolbar
   11  Occupancy Bar
