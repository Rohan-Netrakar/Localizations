<!-- ── Pathfinding Banner ── -->
<div class="pf-banner" id="pfBanner">
  <span>🗺️ Pathfind</span>
  <span class="pf-status" id="pfStatus">Click a room to set start point</span>
  <button class="pf-cancel" onclick="togglePathfind()">✕ Exit</button>
