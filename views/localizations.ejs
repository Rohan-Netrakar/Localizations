<!-- ── Right-click Context Menu ── -->
<div class="ctx-menu" id="ctxMenu">
  <div class="ctx-lbl">Set room status</div>
  <div class="ctx-item" onclick="ctxReserve('exam',  'Exam in Progress 🔒')">🔒 Exam in Progress</div>
  <div class="ctx-item" onclick="ctxReserve('clean', 'Cleaning 🧹')">🧹 Cleaning</div>
  <div class="ctx-item" onclick="ctxReserve('reserv','Reserved 📌')">📌 Reserved</div>
  <div class="ctx-item" onclick="ctxReserve('closed','Closed 🚫')">🚫 Closed</div>
  <div class="ctx-sep"></div>
  <div class="ctx-item ctx-danger" onclick="ctxReserve('clear','')">✕ Clear Status</div>
  <div class="ctx-sep"></div>
  <div class="ctx-item" onclick="ctxHistory()">📅 View 24h History</div>
</div>

<script>
  /* ── All trackable room numbers for this floor ── */
  const DB_ROOMS = [
    '301','302','303','304','305','306','307','309','310','311','313','314',
    '316','317','319','320','321','322','323','324','326',
    '328','329','330','331','332','333','334','335','336','337'
  ];

  let locationMap = {};
  let allRooms    = [];
  let socket      = null;

  /* ── Helpers ── */
  function timeAgo(ts){
    if(!ts) return '—';
    // PostgreSQL TIMESTAMP (no timezone) comes back as "2026-03-07 11:21:14.829885"
    // with no timezone marker. Both server and DB run UTC, so we append Z to
    // force correct UTC parsing — otherwise the browser treats it as local time
    // and shows a 5h30m offset for IST users.
    let s = String(ts).trim().replace(' ', 'T');
    if(!s.endsWith('Z') && !s.includes('+') && !s.match(/[-+]\d{2}:\d{2}$/)) s += 'Z';
    const d = Math.floor((Date.now() - new Date(s)) / 1000);
    if(d < 5)   return 'just now';
    if(d < 60)  return d + 's ago';
    if(d < 3600) return Math.floor(d/60) + 'm ago';
    return Math.floor(d/3600) + 'h ago';
  }
  function initials(uid){ return uid.substring(0,2).toUpperCase(); }

  /* ── Match room by name or embedded 3-digit number ── */
  function usersInRoom(roomNum){
    if(locationMap[roomNum]) return locationMap[roomNum];
    // fallback: search by embedded number in room_name
    for(const [key,arr] of Object.entries(locationMap)){
      const m=key.match(/\b(\d{3})\b/);
      if(m && m[1]===roomNum) return arr;
    }
    return [];
  }

  /* ── Update a single room card ── */
  function updateRoomCard(roomNum){
    const el=document.getElementById('room-'+roomNum);
    if(!el) return;
    const users=usersInRoom(roomNum);
    const occ=users.length>0;
    const chips=document.getElementById('chips-'+roomNum);

    el.className=el.className.replace(/occupied-state|empty-state/g,'').trim();
    el.classList.add(occ?'occupied-state':'empty-state');

    let badge=el.querySelector('.count-badge');
    if(occ){
      if(!badge){ badge=document.createElement('div'); badge.className='count-badge'; el.appendChild(badge); }
      badge.textContent=users.length;
    } else {
      if(badge) badge.remove();
    }

    if(chips){
      const MAX=2;
      chips.innerHTML=occ
        ? users.slice(0,MAX).map(u=>`<div class="chip">${u.user_id}</div>`).join('')
          +(users.length>MAX?`<div class="more-text">+${users.length-MAX} more</div>`:'')
        : '';
    }
  }

  /* ── Modal ── */
  let currentModalRoom = null;
  function openModal(roomNum){
    if(typeof pfMode !== 'undefined' && pfMode){ pfSelectRoom(roomNum); return; }
    currentModalRoom = roomNum;
    const users=usersInRoom(roomNum);
    document.getElementById('mRoom').textContent='Room '+roomNum;
    const list=document.getElementById('mList');
    if(!users.length){
      list.innerHTML=`<div class="m-empty"><span class="m-empty-ico">🚪</span>This room is currently empty</div>`;
    } else {
      list.innerHTML=users.map(u=>`
        <div class="m-row">
          <div class="m-av">${initials(u.user_id)}</div>
          <div>
            <div class="m-name">${u.user_id}</div>
            <div class="m-time">Last seen ${timeAgo(u.last_seen)}</div>
          </div>
        </div>`).join('');
    }
    document.getElementById('overlay').classList.add('open');
  }
  function onBg(e){ if(e.target===document.getElementById('overlay')) closeModal(); }
  function closeModal(){ document.getElementById('overlay').classList.remove('open'); }

  /* ── Build locationMap from API response ── */
  function applyUsers(users){
    locationMap={};
    users.forEach(u=>{
      const name=u.room_name||'';
      if(!locationMap[name]) locationMap[name]=[];
      locationMap[name].push(u);
      // also key by embedded 3-digit number
      const m=name.match(/\b(\d{3})\b/);
      if(m && m[1]!==name){
        if(!locationMap[m[1]]) locationMap[m[1]]=[];
        if(!locationMap[m[1]].find(x=>x.user_id===u.user_id)) locationMap[m[1]].push(u);
      }
    });
  }

  /* ── Fetch from API ── */
  async function fetchData(){
    try{
      const [r1,r2]=await Promise.all([fetch('/api/rooms'),fetch('/api/all-locations')]);
      const rd=await r1.json(), ld=await r2.json();
      if(rd.success) allRooms=rd.rooms;
      if(ld.success) applyUsers(ld.users);

      DB_ROOMS.forEach(updateRoomCard);
      if(typeof logActivity==='function') logActivity();
      if(typeof updateOccupancyBar==='function') updateOccupancyBar();

      const totalPeople=Object.values(locationMap).reduce((s,a)=>s+a.length,0);
      const occRooms=DB_ROOMS.filter(r=>usersInRoom(r).length>0).length;
      document.getElementById('sPeople').textContent=totalPeople;
      document.getElementById('sOcc').textContent=occRooms;
      document.getElementById('sTotal').textContent=allRooms.length||DB_ROOMS.length;
      document.getElementById('lastUpdated').textContent='// updated '+new Date().toLocaleTimeString();
      document.getElementById('liveDot').className='live-dot';
      document.getElementById('liveText').textContent='LIVE';
    } catch(err){
      console.error(err);
      document.getElementById('liveDot').className='live-dot err';
      document.getElementById('liveText').textContent='ERROR';
    }
  }

  /* ── Socket.io for instant updates ── */
  function startSocket(){
    try{
      socket=io({transports:['websocket'],reconnectionDelay:2000});
      socket.on('connect',()=>{ document.getElementById('liveDot').className='live-dot'; });
      socket.on('disconnect',()=>{ document.getElementById('liveDot').className='live-dot err'; });
      socket.on('location-update',data=>{
        /* Remove user from every room first (they moved) */
        for(const key of Object.keys(locationMap)){
          locationMap[key]=locationMap[key].filter(u=>u.user_id!==data.user_id);
        }
        /* Insert into new room, keyed both ways */
        const room=data.room_name||'';
        if(!locationMap[room]) locationMap[room]=[];
        locationMap[room].push(data);
        const m=room.match(/\b(\d{3})\b/);
        if(m && m[1]!==room){
          if(!locationMap[m[1]]) locationMap[m[1]]=[];
          locationMap[m[1]].push(data);
        }
        DB_ROOMS.forEach(updateRoomCard);
        if(typeof logActivity==='function') logActivity();
        if(typeof updateOccupancyBar==='function') updateOccupancyBar();
        const tp=Object.values(locationMap).flat()
          .filter((u,i,a)=>a.findIndex(x=>x.user_id===u.user_id)===i).length;
        const oc=DB_ROOMS.filter(r=>usersInRoom(r).length>0).length;
        document.getElementById('sPeople').textContent=tp;
        document.getElementById('sOcc').textContent=oc;
      });
    } catch(e){
      console.warn('Socket.io unavailable, falling back to polling');
    }
  }

  /* ════════════════════════════════════════════
     FIND-A-PERSON SEARCH
     ════════════════════════════════════════════ */
  let highlightedRoomEl = null;   // currently pulsing room card
  let highlightTimer    = null;   // auto-clear timeout

  const searchInput    = document.getElementById('searchInput');
  const searchDropdown = document.getElementById('searchDropdown');
  const searchBanner   = document.getElementById('searchBanner');
  const searchClear    = document.getElementById('searchClear');

  /* ── Build a flat list of every known user from locationMap ── */
  function getAllUsers(){
    const seen = new Set();
    const out  = [];
    for(const [roomKey, users] of Object.entries(locationMap)){
      /* Only iterate over numeric-keyed entries to avoid duplicates */
      if(!/^\d{3}$/.test(roomKey) && !roomKey.match(/^\d{3}$/)) {
        /* it's a room_name string key — use it */
      }
      for(const u of users){
        if(!seen.has(u.user_id)){
          seen.add(u.user_id);
          out.push(u);
        }
      }
    }
    return out;
  }

  /* ── Find which room number a user is in (for scrolling) ── */
  function roomNumForUser(u){
    const name = u.room_name || '';
    /* Direct match: name is exactly '303' */
    if(document.getElementById('room-' + name)) return name;
    /* Embedded match: name is 'Room 303' etc */
    const m = name.match(/\b(\d{3})\b/);
    if(m && document.getElementById('room-' + m[1])) return m[1];
    /* Search locationMap keys */
    for(const [key, arr] of Object.entries(locationMap)){
      if(arr.find(x => x.user_id === u.user_id)){
        const k2 = key.match(/\b(\d{3})\b/);
        if(k2 && document.getElementById('room-' + k2[1])) return k2[1];
        if(document.getElementById('room-' + key)) return key;
      }
    }
    return null;
  }

  /* ── Highlight (pulse) a room card and scroll to it ── */
  function highlightRoom(roomNum){
    /* Clear any previous highlight */
    if(highlightedRoomEl){
      highlightedRoomEl.classList.remove('room-highlight');
      highlightedRoomEl = null;
    }
    clearTimeout(highlightTimer);

    const el = document.getElementById('room-' + roomNum);
    if(!el) return;

    highlightedRoomEl = el;
    el.classList.add('room-highlight');
    el.scrollIntoView({ behavior:'smooth', block:'center', inline:'center' });

    /* Auto-remove pulse after 6 seconds */
    highlightTimer = setTimeout(()=>{
      el.classList.remove('room-highlight');
      highlightedRoomEl = null;
    }, 6000);
  }

  /* ── Show the result banner ── */
  function showBanner(user, roomNum){
    const name = user.room_name || roomNum || '?';
    searchBanner.className = 'search-result-banner found';
    searchBanner.innerHTML =
      '<span class="srb-icon">📍</span>' +
      '<span class="srb-text"><strong>' + escHtml(user.user_id) + '</strong>' +
        ' is in <strong>Room ' + escHtml(roomNum||name) + '</strong>' +
        ' &nbsp;·&nbsp; ' + timeAgo(user.last_seen) + '</span>' +
      '<button class="srb-goto" onclick="highlightRoom(\'' + escHtml(roomNum) + '\')">Go →</button>';
  }

  function showNotFound(query){
    searchBanner.className = 'search-result-banner notfound';
    searchBanner.innerHTML =
      '<span class="srb-icon">🚫</span>' +
      '<span class="srb-text"><strong>' + escHtml(query) + '</strong> is not on this floor right now</span>';
  }

  function hideBanner(){
    searchBanner.className = 'search-result-banner';
    searchBanner.innerHTML = '';
  }

  /* ── Render the dropdown suggestions ── */
  function renderDropdown(query){
    const q = query.trim().toLowerCase();
    searchDropdown.innerHTML = '';

    if(!q){ searchDropdown.classList.remove('open'); return; }

    const all = getAllUsers();
    const matches = all.filter(u => u.user_id.toLowerCase().includes(q));

    if(!matches.length){
      searchDropdown.innerHTML = '<div class="sd-empty">No one found matching "' + escHtml(query) + '"</div>';
      searchDropdown.classList.add('open');
      return;
    }

    /* Cap at 6 suggestions */
    matches.slice(0, 6).forEach(u => {
      const roomNum = roomNumForUser(u);
      const roomLabel = roomNum ? 'Room ' + roomNum : (u.room_name || '?');
      const div = document.createElement('div');
      div.className = 'sd-item';
      div.innerHTML =
        '<div class="sd-av">' + escHtml(initials(u.user_id)) + '</div>' +
        '<div class="sd-info">' +
          '<div class="sd-name">' + escHtml(u.user_id) + '</div>' +
          '<div class="sd-room">' + escHtml(roomLabel) + '</div>' +
        '</div>' +
        '<div class="sd-time">' + timeAgo(u.last_seen) + '</div>';

      div.addEventListener('mousedown', function(e){
        /* mousedown fires before blur; prevent input blur hiding dropdown */
        e.preventDefault();
        selectUser(u, roomNum);
      });
      searchDropdown.appendChild(div);
    });

    searchDropdown.classList.add('open');
  }

  /* ── Called when user picks someone (click or Enter) ── */
  function selectUser(user, roomNum){
    searchInput.value = user.user_id;
    searchClear.classList.add('visible');
    searchDropdown.classList.remove('open');

    if(roomNum){
      showBanner(user, roomNum);
      highlightRoom(roomNum);
    } else {
      showNotFound(user.user_id);
    }
  }

  /* ── Clear everything ── */
  function clearSearch(){
    searchInput.value = '';
    searchClear.classList.remove('visible');
    searchDropdown.classList.remove('open');
    hideBanner();
    if(highlightedRoomEl){
      highlightedRoomEl.classList.remove('room-highlight');
      highlightedRoomEl = null;
    }
    clearTimeout(highlightTimer);
    searchInput.focus();
  }

  /* ── Sanitise strings inserted into innerHTML ── */
  function escHtml(s){
    return String(s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ── Input events ── */
  searchInput.addEventListener('input', function(){
    const q = this.value;
    searchClear.classList.toggle('visible', q.length > 0);
    hideBanner();
    renderDropdown(q);
  });

  searchInput.addEventListener('keydown', function(e){
    if(e.key === 'Escape'){ clearSearch(); return; }
    if(e.key === 'Enter'){
      const q = this.value.trim();
      if(!q) return;
      searchDropdown.classList.remove('open');
      /* Find best match */
      const all = getAllUsers();
      /* Exact match first, then partial */
      const exact   = all.find(u => u.user_id.toLowerCase() === q.toLowerCase());
      const partial = all.find(u => u.user_id.toLowerCase().includes(q.toLowerCase()));
      const user    = exact || partial;
      if(user){
        const roomNum = roomNumForUser(user);
        selectUser(user, roomNum);
      } else {
        hideBanner();
        showNotFound(q);
      }
    }
  });

  /* Close dropdown when clicking outside */
  document.addEventListener('click', function(e){
    if(!document.getElementById('searchWrap').contains(e.target)){
      searchDropdown.classList.remove('open');
    }
  });


  /* ════════════════════════════════════════════════════════════
     FEATURE CONFIG
  ════════════════════════════════════════════════════════════ */
  const ROOM_CAPACITY = {
    '301':30,'302':40,'303':30,'304':25,'305':25,'306':20,
    '307':25,'309':40,'310':40,'311':40,'313':40,'314':15,
    '316':35,'317':35,'319':20,'320':35,'321':20,'322':35,
    '323':35,'324':35,'326':20,'328':40,'329':40,'330':40,
    '331':40,'332':40,'333':30,'334':30,'335':30,'336':30,'337':30
  };

  /* ════════════════════════════════════════════════════════════
     FEATURE 4 — STALE USER TIMEOUT (15 min)
  ════════════════════════════════════════════════════════════ */
  const STALE_MS = 15 * 60 * 1000;
  function isStale(ts){
    if(!ts) return false;
    let s=String(ts).trim().replace(' ','T');
    if(!s.endsWith('Z')&&!s.includes('+')&&!s.match(/[-+]\d{2}:\d{2}$/)) s+='Z';
    return (Date.now()-new Date(s))>STALE_MS;
  }

  /* ════════════════════════════════════════════════════════════
     FEATURE 9 — SPARKLINE (in-memory 1-hour activity log)
  ════════════════════════════════════════════════════════════ */
  const heatLog={};
  const MAX_BUCKETS=12; // 12 × ~5 min polls ≈ 1 hour

  function logActivity(){
    DB_ROOMS.forEach(r=>{
      if(!heatLog[r]) heatLog[r]=[];
      heatLog[r].push(usersInRoom(r).length);
      if(heatLog[r].length>MAX_BUCKETS) heatLog[r].shift();
    });
    /* Refresh sparklines only (cheap) */
    DB_ROOMS.forEach(renderSparkline);
  }

  function renderSparkline(roomNum){
    const el=document.getElementById('room-'+roomNum);
    if(!el) return;
    let wrap=el.querySelector('.sparkline-wrap');
    if(!wrap){ wrap=document.createElement('div'); wrap.className='sparkline-wrap'; el.appendChild(wrap); }
    const data=heatLog[roomNum]||[];
    if(data.length<2){ wrap.innerHTML=''; return; }
    const W=46,H=14;
    const max=Math.max(...data,1);
    const pts=data.map((c,i)=>{
      const x=(i/(data.length-1))*W;
      const y=H-(c/max)*(H-2)-1;
      return x.toFixed(1)+','+y.toFixed(1);
    }).join(' ');
    const col=max===0?'#94a3b8':max>=5?'#ef4444':max>=2?'#f59e0b':'#10b981';
    wrap.innerHTML='<svg width="'+W+'" height="'+H+'" style="opacity:.65"><polyline points="'+pts+'" fill="none" stroke="'+col+'" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/></svg>';
  }

  /* ════════════════════════════════════════════════════════════
     FEATURE 5 — FLOOR OCCUPANCY BAR
  ════════════════════════════════════════════════════════════ */
  function updateOccupancyBar(){
    const total=DB_ROOMS.length;
    const occ=DB_ROOMS.filter(r=>usersInRoom(r).length>0).length;
    const people=Object.values(locationMap).flat()
      .filter((u,i,a)=>a.findIndex(x=>x.user_id===u.user_id)===i).length;
    const pct=total>0?Math.round(occ/total*100):0;
    const lbl=document.getElementById('occLabel');
    const fill=document.getElementById('occFill');
    if(lbl) lbl.textContent=occ+'/'+total+' rooms occupied · '+people+' people on floor';
    if(fill) fill.style.width=pct+'%';
  }

  /* ════════════════════════════════════════════════════════════
     FEATURE 3 — HEATMAP OVERLAY
  ════════════════════════════════════════════════════════════ */
  let heatmapOn=false;
  function toggleHeatmap(){
    heatmapOn=!heatmapOn;
    const btn=document.getElementById('btnHeatmap');
    if(btn) btn.classList.toggle('active',heatmapOn);
    DB_ROOMS.forEach(applyHeatClass);
  }
  function heatScore(r){ return (heatLog[r]||[]).reduce((s,c)=>s+c,0); }
  function applyHeatClass(roomNum){
    const el=document.getElementById('room-'+roomNum);
    if(!el) return;
    el.classList.remove('hm-cold','hm-cool','hm-warm','hm-hot');
    if(!heatmapOn) return;
    const s=heatScore(roomNum);
    if(s===0)     el.classList.add('hm-cold');
    else if(s<=3) el.classList.add('hm-cool');
    else if(s<=9) el.classList.add('hm-warm');
    else          el.classList.add('hm-hot');
  }

  /* ════════════════════════════════════════════════════════════
     FEATURE 7 — ROOM CAPACITY WARNING
  ════════════════════════════════════════════════════════════ */
  function applyCapacity(roomNum, el, count){
    el.classList.remove('over-capacity');
    const old=el.querySelector('.cap-badge');
    if(old) old.remove();
    const cap=ROOM_CAPACITY[roomNum];
    if(!cap||count===0) return;
    if(count>=cap){
      el.classList.add('over-capacity');
      const b=document.createElement('div');
      b.className='cap-badge'; b.textContent='⚠ Full'; el.appendChild(b);
    }
  }

  /* ════════════════════════════════════════════════════════════
     ENRICH HOOK — runs after every updateRoomCard call
  ════════════════════════════════════════════════════════════ */
  const _origURC=updateRoomCard;
  updateRoomCard=function(roomNum){
    _origURC(roomNum);
    const el=document.getElementById('room-'+roomNum);
    if(!el) return;
    const users=usersInRoom(roomNum);

    /* Feature 4: stale */
    el.classList.remove('stale-room');
    const sb=el.querySelector('.stale-badge');
    if(sb) sb.remove();
    if(users.length>0 && users.every(u=>isStale(u.last_seen))){
      el.classList.add('stale-room');
      const b=document.createElement('div'); b.className='stale-badge'; b.textContent='⚠ stale'; el.appendChild(b);
    }

    /* Feature 7: capacity */
    applyCapacity(roomNum,el,users.length);

    /* Feature 3: heatmap */
    applyHeatClass(roomNum);

    /* Feature 12: reservation tag */
    applyReservationTag(roomNum);
  };

  /* ════════════════════════════════════════════════════════════
     FEATURE 12 — ROOM RESERVATIONS (right-click context menu)
  ════════════════════════════════════════════════════════════ */
  let reservations={};
  let ctxTargetRoom=null;
  const ctxMenu=document.getElementById('ctxMenu');

  const RES={
    exam:  {cls:'res-exam',   label:'Exam in Progress 🔒'},
    clean: {cls:'res-clean',  label:'Cleaning 🧹'},
    reserv:{cls:'res-reserv', label:'Reserved 📌'},
    closed:{cls:'res-closed', label:'Closed 🚫'},
  };

  function applyReservationTag(roomNum){
    const el=document.getElementById('room-'+roomNum);
    if(!el) return;
    let tag=el.querySelector('.res-tag');
    const rv=reservations[roomNum];
    if(!rv){ if(tag) tag.remove(); return; }
    if(!tag){ tag=document.createElement('div'); tag.className='res-tag'; el.prepend(tag); }
    const opt=RES[rv.tag]||{cls:'res-reserv',label:rv.label};
    tag.className='res-tag '+opt.cls;
    tag.textContent=rv.label||opt.label;
  }

  async function loadReservations(){
    try{
      const r=await fetch('/api/room-reservations');
      const d=await r.json();
      if(d.success && d.reservations){
        reservations={};
        d.reservations.forEach(rv=>{ reservations[rv.room_name]={tag:rv.tag,label:rv.label}; });
        DB_ROOMS.forEach(applyReservationTag);
      }
    }catch(e){ /* endpoint may not exist yet — silently skip */ }
  }

  async function setReservation(roomNum,tag,label){
    /* Optimistic update */
    if(tag==='clear') delete reservations[roomNum];
    else reservations[roomNum]={tag,label};
    applyReservationTag(roomNum);
    try{
      if(tag==='clear'){
        await fetch('/api/room-reservation/'+encodeURIComponent(roomNum),{method:'DELETE'});
      } else {
        await fetch('/api/room-reservation',{
          method:'POST', headers:{'Content-Type':'application/json'},
          body:JSON.stringify({room_name:roomNum,tag,label})
        });
      }
    }catch(e){ console.warn('reservation API unavailable'); }
  }

  function ctxReserve(tag,label){
    if(ctxTargetRoom) setReservation(ctxTargetRoom,tag,label);
    ctxMenu.classList.remove('open');
  }
  function ctxHistory(){
    if(ctxTargetRoom) openTimeline(ctxTargetRoom);
    ctxMenu.classList.remove('open');
  }

  /* Right-click listener */
  document.addEventListener('contextmenu',function(e){
    const room=e.target.closest('.db-room');
    if(!room){ ctxMenu.classList.remove('open'); return; }
    e.preventDefault();
    ctxTargetRoom=room.dataset.room;
    ctxMenu.style.left=Math.min(e.pageX,window.innerWidth-200)+'px';
    ctxMenu.style.top =Math.min(e.pageY,window.innerHeight-260)+'px';
    ctxMenu.classList.add('open');
  });
  document.addEventListener('click',()=>ctxMenu.classList.remove('open'));

  /* ════════════════════════════════════════════════════════════
     FEATURE 6 — ATTENDANCE CSV EXPORT
  ════════════════════════════════════════════════════════════ */
  function exportCSV(){
    const rows=[['user_id','room_name','last_seen']];
    const seen=new Set();
    DB_ROOMS.forEach(r=>{
      usersInRoom(r).forEach(u=>{
        if(!seen.has(u.user_id)){
          seen.add(u.user_id);
          rows.push([
            '"'+String(u.user_id).replace(/"/g,'""')+'"',
            '"'+String(u.room_name||r).replace(/"/g,'""')+'"',
            '"'+String(u.last_seen||'').replace(/"/g,'""')+'"'
          ]);
        }
      });
    });
    const csv=rows.map(r=>r.join(',')).join('\n');
    const a=document.createElement('a');
    a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));
    a.download='attendance_'+new Date().toISOString().slice(0,16).replace(/:/g,'-')+'.csv';
    a.click();
  }

  /* ════════════════════════════════════════════════════════════
     FEATURE 8 — SHAREABLE ROOM LINK  (?room=303)
  ════════════════════════════════════════════════════════════ */
  function checkUrlParam(){
    const p=new URLSearchParams(window.location.search).get('room');
    if(!p) return;
    let tries=0;
    const t=setInterval(()=>{
      if(document.getElementById('room-'+p)||++tries>25){ clearInterval(t); }
      if(document.getElementById('room-'+p)){
        setTimeout(()=>{ highlightRoom(p); openModal(p); },350);
        clearInterval(t);
      }
    },200);
  }

  /* ════════════════════════════════════════════════════════════
     FEATURE 2 — ROOM HISTORY TIMELINE (24h)
  ════════════════════════════════════════════════════════════ */
  function openTimelineForCurrentRoom(){
    closeModal();
    if(currentModalRoom) openTimeline(currentModalRoom);
  }

  function openTimeline(roomNum){
    document.getElementById('tlTitle').textContent='Room '+roomNum+' — 24h History';
    const body=document.getElementById('tlBody');
    body.innerHTML='<div class="tl-loading">⏳ Loading…</div>';
    document.getElementById('tlOverlay').classList.add('open');

    fetch('/api/room-history/'+encodeURIComponent(roomNum))
      .then(r=>r.json())
      .then(d=>{
        if(!d.success||!d.history||!d.history.length){
          body.innerHTML='<div class="tl-empty">📭 No activity recorded in the last 24 hours</div>';
          return;
        }
        body.innerHTML=d.history.map((e,i)=>`
          <div class="tl-entry">
            <div style="position:relative">
              <div class="tl-dot"></div>
              ${i<d.history.length-1?'<div class="tl-line"></div>':''}
            </div>
            <div class="tl-info">
              <div class="tl-name">${escHtml(e.user_id)}</div>
              <div class="tl-time">${fmtDateTime(e.entered_at)}</div>
            </div>
          </div>`).join('');
      })
      .catch(()=>{ body.innerHTML='<div class="tl-empty">⚠️ History not available</div>'; });
  }

  function closeTimeline(){ document.getElementById('tlOverlay').classList.remove('open'); }

  function fmtDateTime(ts){
    if(!ts) return '—';
    let s=String(ts).trim().replace(' ','T');
    if(!s.endsWith('Z')&&!s.includes('+')&&!s.match(/[-+]\d{2}:\d{2}$/)) s+='Z';
    return new Date(s).toLocaleString('en-IN',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',hour12:true});
  }

  /* ════════════════════════════════════════════════════════════
     FEATURE 11 — EMERGENCY ROLL CALL
  ════════════════════════════════════════════════════════════ */
  function openEmergency(){
    const seen=new Set();
    const byRoom={};
    DB_ROOMS.forEach(r=>{
      usersInRoom(r).forEach(u=>{
        if(!seen.has(u.user_id)){
          seen.add(u.user_id);
          if(!byRoom[r]) byRoom[r]=[];
          byRoom[r].push(u);
        }
      });
    });
    const occupied=Object.keys(byRoom).sort();
    const body=document.getElementById('emBody');
    if(!occupied.length){
      body.innerHTML='<div style="color:rgba(255,255,255,.45);text-align:center;padding:60px;font-family:var(--mono);font-size:.9rem;grid-column:1/-1;">No one currently on this floor</div>';
    } else {
      body.innerHTML=occupied.map(r=>`
        <div class="em-card">
          <div class="em-room-n">Room ${escHtml(r)} <span style="font-size:.68rem;font-weight:400;color:rgba(255,255,255,.35)">(${byRoom[r].length})</span></div>
          ${byRoom[r].map(u=>`
            <div class="em-person">
              <div class="em-av">${escHtml(initials(u.user_id))}</div>
              <div>
                <div class="em-uid">${escHtml(u.user_id)}</div>
                <div class="em-ts">${timeAgo(u.last_seen)}</div>
              </div>
            </div>`).join('')}
        </div>`).join('');
    }
    document.getElementById('emTotal').textContent=
      seen.size+' '+(seen.size===1?'person':'people')+' on floor · '+occupied.length+' rooms · '+new Date().toLocaleTimeString();
    document.getElementById('emOverlay').classList.add('open');
  }
  function closeEmergency(){ document.getElementById('emOverlay').classList.remove('open'); }

  /* ════════════════════════════════════════════════════════════
     FEATURE 10 — PATHFINDING (BFS through floor graph)
  ════════════════════════════════════════════════════════════ */
  const PF_GRAPH={
    '303':['304','306'],       '304':['303','305'],        '305':['304','307'],
    '307':['305','310','302'], '310':['307','314'],         '314':['310','319','316'],
    '316':['314','317'],       '317':['316','320'],         '320':['317','322'],
    '322':['320','323'],       '323':['322','324'],         '324':['323','326'],
    '306':['303','301'],       '301':['306','337','302'],   '337':['301','335','334'],
    '302':['307','301','309','334'],
    '309':['302','311'],       '311':['309','313'],
    '313':['311','319','328'], '319':['314','313','321'],   '321':['319','328','326'],
    '328':['313','321','329'], '329':['328','331'],          '331':['329','334'],
    '334':['337','302','331','333'],
    '333':['334','332','335'], '335':['337','333','336'],
    '332':['333','330'],       '330':['332','326'],          '326':['330','321','324'],
    '336':['335'],
  };

  let pfMode=false, pfSource=null, pfDest=null;
  let pfHighlit=[];

  function togglePathfind(){
    pfMode=!pfMode;
    const btn=document.getElementById('btnPathfind');
    const banner=document.getElementById('pfBanner');
    if(btn) btn.classList.toggle('active',pfMode);
    if(banner) banner.classList.toggle('visible',pfMode);
    if(!pfMode) clearPfHighlight();
  }

  function clearPfHighlight(){
    pfHighlit.forEach(r=>{
      const e=document.getElementById('room-'+r);
      if(e) e.classList.remove('pf-source','pf-dest','pf-path');
    });
    pfHighlit=[]; pfSource=null; pfDest=null;
    const s=document.getElementById('pfStatus');
    if(s) s.textContent='Click a room to set start point';
  }

  function pfSelectRoom(roomNum){
    if(!pfSource){
      pfSource=roomNum;
      pfHighlit.push(roomNum);
      const el=document.getElementById('room-'+roomNum);
      if(el) el.classList.add('pf-source');
      const s=document.getElementById('pfStatus');
      if(s) s.textContent='Start: '+roomNum+' → now click destination';
      return;
    }
    if(roomNum===pfSource){ clearPfHighlight(); return; }
    pfDest=roomNum;
    runBFS(pfSource,pfDest);
  }

  function bfs(start,end){
    if(start===end) return [start];
    const prev={[start]:null};
    const q=[start];
    while(q.length){
      const n=q.shift();
      for(const nb of (PF_GRAPH[n]||[])){
        if(nb in prev) continue;
        prev[nb]=n;
        if(nb===end){
          const path=[]; let cur=nb;
          while(cur!==null){ path.unshift(cur); cur=prev[cur]; }
          return path;
        }
        q.push(nb);
      }
    }
    return null;
  }

  function runBFS(src,dst){
    clearPfHighlight();
    pfSource=src; pfDest=dst;
    const path=bfs(src,dst);
    const s=document.getElementById('pfStatus');
    if(!path){
      if(s) s.textContent='No path found between '+src+' and '+dst;
      return;
    }
    path.forEach((r,i)=>{
      pfHighlit.push(r);
      const el=document.getElementById('room-'+r);
      if(!el) return;
      if(i===0)              el.classList.add('pf-source');
      else if(i===path.length-1) el.classList.add('pf-dest');
      else                   el.classList.add('pf-path');
    });
    if(s) s.textContent=path.join(' → ')+' ('+( path.length-1)+' hops)';
  }

  /* ── Boot ── */
  fetchData();
  startSocket();
  setInterval(function(){ if(!socket||!socket.connected) fetchData(); }, 8000);
  loadReservations();
  checkUrlParam();



  /* ── Visibility API ── */
  document.addEventListener('visibilitychange',()=>{ if(!document.hidden) fetchData(); });
</script>
</body>
</html>
