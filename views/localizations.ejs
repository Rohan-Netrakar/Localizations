<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Floor Map – IndoorLocate</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="/socket.io/socket.io.js"></script>
  <style>
    /* ═══════════════════════════════════════════════════════════════
   IndoorLocate — Floor Map  |  localizations.css
   Modern responsive design · Mobile · Tablet · Laptop · Desktop
   Design direction: Precision Tech Dashboard — dark navy shell,
   crisp mono type, surgical blue accents, real-time energy.
═══════════════════════════════════════════════════════════════ */

/* ── Google Fonts loaded in HTML head ── */

/* ─────────────────────────────────────────
   1. DESIGN TOKENS
───────────────────────────────────────── */
:root {
  /* Palette */
  --wall:          #111827;
  --wall-mid:      #1a2336;
  --wall-light:    #1e2d45;
  --corridor:      #b8c4d4;
  --floor-bg:      #dde4ee;
  --static-room:   #cfd6e8;
  --static-border: #a4aec4;
  --empty-room:    #e8ecf6;
  --empty-border:  #b4bcd4;
  --occ-room:      #ffffff;
  --occ-border:    #2563eb;
  --occ-glow:      rgba(37,99,235,0.15);

  --accent:        #2563eb;
  --accent-light:  #3b82f6;
  --accent-dim:    rgba(37,99,235,0.08);
  --accent2:       #06b6d4;
  --green:         #10b981;
  --amber:         #f59e0b;
  --red:           #ef4444;
  --text:          #0f172a;
  --text-mid:      #334155;
  --muted:         #64748b;
  --muted-light:   #94a3b8;

  --stair-bg:      #a4afc4;
  --stair-text:    #4a5470;
  --service-bg:    #c8cfe0;

  /* Typography */
  --mono: 'IBM Plex Mono', monospace;
  --sans: 'Outfit', sans-serif;

  /* Spacing */
  --gap-xs:  4px;
  --gap-s:   8px;
  --gap-m:   16px;
  --gap-l:   24px;
  --gap-xl:  32px;

  /* Radii */
  --r-s: 6px;
  --r-m: 10px;
  --r-l: 16px;
  --r-xl:24px;

  /* Shadows */
  --shadow-s: 0 1px 4px rgba(0,0,0,0.12);
  --shadow-m: 0 4px 16px rgba(0,0,0,0.14);
  --shadow-l: 0 12px 40px rgba(0,0,0,0.22);
  --shadow-xl:0 24px 64px rgba(0,0,0,0.28);

  /* Transitions */
  --tr-fast: 0.14s ease;
  --tr-mid:  0.22s cubic-bezier(.34,1.56,.64,1);
  --tr-slow: 0.35s ease;
}

/* ─────────────────────────────────────────
   2. RESET & BASE
───────────────────────────────────────── */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

html { -webkit-tap-highlight-color: transparent; }

body {
  font-family: var(--sans);
  background: #0d1523;
  background-image:
    radial-gradient(ellipse 80% 60% at 20% 0%, rgba(37,99,235,0.07) 0%, transparent 60%),
    radial-gradient(ellipse 60% 50% at 80% 100%, rgba(6,182,212,0.05) 0%, transparent 60%);
  color: var(--text);
  min-height: 100vh;
}

/* ─────────────────────────────────────────
   3. NAVBAR
───────────────────────────────────────── */
.navbar {
  background: var(--wall);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  position: sticky;
  top: 0;
  z-index: 200;
  box-shadow: 0 2px 20px rgba(0,0,0,0.4);
  backdrop-filter: blur(12px);
}

.logo {
  font-family: var(--mono);
  font-size: 1rem;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1.5px;
  display: flex;
  align-items: center;
  gap: 2px;
}
.logo span { color: var(--accent2); }

.nav-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.live-pill {
  display: flex;
  align-items: center;
  gap: 7px;
  background: rgba(16,185,129,0.1);
  border: 1px solid rgba(16,185,129,0.28);
  border-radius: 20px;
  padding: 4px 12px;
  font-family: var(--mono);
  font-size: 0.65rem;
  color: var(--green);
  letter-spacing: 0.8px;
}

.live-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--green);
  animation: blink 1.8s ease-in-out infinite;
  flex-shrink: 0;
}
.live-dot.err { background: var(--red); animation: none; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.25} }

.nav-btn {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.85);
  padding: 6px 14px;
  border-radius: var(--r-s);
  cursor: pointer;
  font-family: var(--sans);
  font-size: 0.78rem;
  font-weight: 500;
  transition: all var(--tr-fast);
  white-space: nowrap;
}
.nav-btn:hover {
  background: rgba(255,255,255,0.14);
  border-color: rgba(255,255,255,0.22);
  color: #fff;
}

/* ─────────────────────────────────────────
   4. TOPBAR (stats + search)
───────────────────────────────────────── */
.topbar {
  background: var(--wall-mid);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}

.building-info h2 {
  font-size: 0.92rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.2px;
}
.building-info p {
  font-family: var(--mono);
  font-size: 0.62rem;
  color: var(--muted-light);
  margin-top: 3px;
}

/* Search */
.search-bar-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.05);
  border: 1.5px solid rgba(255,255,255,0.1);
  border-radius: var(--r-m);
  padding: 6px 12px 6px 14px;
  transition: border-color var(--tr-fast), box-shadow var(--tr-fast), background var(--tr-fast);
  position: relative;
  flex: 1;
  max-width: 300px;
  min-width: 180px;
}
.search-bar-wrap:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(37,99,235,0.18);
  background: rgba(255,255,255,0.08);
}

.search-icon { font-size: 0.82rem; flex-shrink: 0; opacity: 0.6; }

.search-input {
  border: none;
  background: transparent;
  outline: none;
  font-family: var(--mono);
  font-size: 0.74rem;
  color: #fff;
  width: 100%;
  min-width: 0;
}
.search-input::placeholder { color: rgba(255,255,255,0.3); }

.search-clear {
  border: none;
  background: none;
  cursor: pointer;
  color: rgba(255,255,255,0.3);
  font-size: 0.85rem;
  padding: 0 2px;
  flex-shrink: 0;
  line-height: 1;
  display: none;
  transition: color var(--tr-fast);
}
.search-clear.visible { display: block; }
.search-clear:hover { color: var(--red); }

/* Search dropdown */
.search-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  left: 0; right: 0;
  background: var(--wall);
  border: 1.5px solid rgba(255,255,255,0.1);
  border-radius: var(--r-m);
  box-shadow: var(--shadow-xl);
  z-index: 500;
  overflow: hidden;
  display: none;
}
.search-dropdown.open { display: block; }

.sd-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  cursor: pointer;
  transition: background var(--tr-fast);
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
.sd-item:last-child { border-bottom: none; }
.sd-item:hover { background: rgba(37,99,235,0.15); }

.sd-av {
  width: 30px; height: 30px;
  border-radius: 8px;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 0.6rem;
  font-weight: 700;
  color: #fff;
}
.sd-info { flex: 1; min-width: 0; }
.sd-name {
  font-weight: 700;
  font-size: 0.78rem;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sd-room {
  font-family: var(--mono);
  font-size: 0.6rem;
  color: var(--accent2);
  margin-top: 1px;
}
.sd-time {
  font-family: var(--mono);
  font-size: 0.58rem;
  color: var(--muted-light);
  flex-shrink: 0;
}
.sd-empty {
  padding: 14px;
  text-align: center;
  font-family: var(--mono);
  font-size: 0.7rem;
  color: var(--muted-light);
}

/* Search result banner */
.search-result-banner {
  position: absolute;
  top: calc(100% + 8px);
  left: 0; right: 0;
  border-radius: var(--r-m);
  padding: 10px 14px;
  display: none;
  align-items: center;
  gap: 10px;
  font-family: var(--mono);
  font-size: 0.7rem;
  z-index: 500;
}
.search-result-banner.found {
  display: flex;
  background: rgba(37,99,235,0.18);
  border: 1.5px solid rgba(37,99,235,0.35);
  color: #93c5fd;
}
.search-result-banner.notfound {
  display: flex;
  background: rgba(239,68,68,0.12);
  border: 1.5px solid rgba(239,68,68,0.3);
  color: #fca5a5;
}
.srb-icon { font-size: 1rem; flex-shrink: 0; }
.srb-text { flex: 1; line-height: 1.4; }
.srb-goto {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: var(--r-s);
  padding: 4px 10px;
  font-family: var(--mono);
  font-size: 0.63rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  transition: opacity var(--tr-fast);
}
.srb-goto:hover { opacity: 0.85; }

/* Stats row */
.stats {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.stat { text-align: center; }
.stat-n {
  font-family: var(--mono);
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--accent-light);
  line-height: 1;
}
.stat-l {
  font-size: 0.58rem;
  color: var(--muted-light);
  text-transform: uppercase;
  letter-spacing: 0.6px;
  margin-top: 3px;
}
.sep {
  width: 1px;
  height: 26px;
  background: rgba(255,255,255,0.1);
}

.refresh-btn {
  background: var(--accent);
  border: none;
  color: #fff;
  padding: 7px 14px;
  border-radius: var(--r-s);
  cursor: pointer;
  font-family: var(--mono);
  font-size: 0.7rem;
  font-weight: 500;
  transition: all var(--tr-fast);
  white-space: nowrap;
}
.refresh-btn:hover {
  background: var(--accent-light);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(37,99,235,0.35);
}

/* ─────────────────────────────────────────
   5. FEATURE TOOLBAR
───────────────────────────────────────── */
.toolbar {
  background: var(--wall-light);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 8px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
}

/* Occupancy bar */
.occ-bar-outer { flex: 1; min-width: 160px; max-width: 360px; }
.occ-bar-label {
  font-family: var(--mono);
  font-size: 0.59rem;
  color: var(--muted-light);
  margin-bottom: 5px;
  letter-spacing: 0.3px;
}
.occ-bar-track {
  height: 6px;
  background: rgba(255,255,255,0.08);
  border-radius: 20px;
  overflow: hidden;
}
.occ-bar-fill {
  height: 100%;
  border-radius: 20px;
  width: 0%;
  background: linear-gradient(90deg, var(--green) 0%, var(--amber) 55%, var(--red) 100%);
  transition: width 0.7s cubic-bezier(.4,0,.2,1);
  box-shadow: 0 0 8px rgba(16,185,129,0.4);
}

/* Tool buttons */
.tool-btns {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  align-items: center;
}
.tool-btn {
  background: rgba(255,255,255,0.05);
  border: 1.5px solid rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.75);
  padding: 5px 12px;
  border-radius: var(--r-s);
  cursor: pointer;
  font-family: var(--mono);
  font-size: 0.62rem;
  font-weight: 500;
  transition: all var(--tr-fast);
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 5px;
}
.tool-btn:hover {
  background: rgba(37,99,235,0.2);
  border-color: var(--accent);
  color: #93c5fd;
  transform: translateY(-1px);
  box-shadow: 0 3px 10px rgba(37,99,235,0.2);
}
.tool-btn.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
  box-shadow: 0 0 14px rgba(37,99,235,0.4);
}
.tool-btn.danger {
  border-color: rgba(239,68,68,0.35);
  color: #fca5a5;
}
.tool-btn.danger:hover {
  background: rgba(239,68,68,0.2);
  border-color: var(--red);
  color: #fff;
  box-shadow: 0 3px 10px rgba(239,68,68,0.2);
}

/* ─────────────────────────────────────────
   6. FLOOR PLAN WRAPPER & BUILDING SHELL
───────────────────────────────────────── */
.fp-wrapper {
  padding: 20px 16px 32px;
  overflow-x: auto;
  min-height: calc(100vh - 160px);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  /* Subtle scroll hint on small screens */
  -webkit-overflow-scrolling: touch;
}

/* Scroll-hint fade on right edge for small screens */
@media (max-width: 900px) {
  .fp-wrapper {
    justify-content: flex-start;
    position: relative;
  }
}

.building {
  background: var(--wall);
  border-radius: 16px;
  padding: 16px;
  width: 100%;
  max-width: 1160px;
  min-width: 640px; /* floor plan needs this minimum — enables scroll */
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.06),
    0 20px 60px rgba(0,0,0,0.5),
    0 0 80px rgba(37,99,235,0.05);
  position: relative;
}

/* Subtle inner glow on building */
.building::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(37,99,235,0.04) 0%, transparent 50%);
  pointer-events: none;
}

.building-label {
  font-family: var(--mono);
  font-size: 0.56rem;
  color: rgba(255,255,255,0.22);
  text-transform: uppercase;
  letter-spacing: 2.5px;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.building-label::before {
  content: '';
  display: inline-block;
  width: 18px;
  height: 1px;
  background: rgba(255,255,255,0.2);
}

/* ─────────────────────────────────────────
   7. FLOOR PLAN GRID — STRUCTURE UNCHANGED
───────────────────────────────────────── */
.fp {
  display: grid;
  grid-template-columns: 42px 1fr 1fr 36px 1fr 1fr 1fr 1fr 1fr 10px 1fr;
  grid-template-rows: auto 14px auto auto auto 14px auto;
  gap: 0;
  background: var(--corridor);
  border-radius: 10px;
  overflow: hidden;
}

/* ─────────────────────────────────────────
   8. ROOM CARDS
───────────────────────────────────────── */
.room {
  background: var(--static-room);
  border: 1.5px solid var(--static-border);
  margin: 3px;
  border-radius: var(--r-s);
  padding: 7px 6px;
  display: flex;
  flex-direction: column;
  min-height: 72px;
  position: relative;
  font-size: 0.65rem;
  color: var(--muted);
  font-family: var(--mono);
  overflow: hidden;
}

/* door notch */
.room::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 50%;
  transform: translateX(-50%);
  width: 16px;
  height: 3px;
  background: var(--corridor);
  border-radius: 2px 2px 0 0;
}

.room-num {
  font-size: 0.88rem;
  font-weight: 700;
  color: #3a4562;
  line-height: 1;
  margin-bottom: 2px;
}
.room-name-label {
  font-size: 0.52rem;
  color: var(--muted);
  line-height: 1.3;
  margin-bottom: 3px;
  word-break: break-word;
}

/* DB rooms — live tracked */
.db-room {
  cursor: pointer;
  transition: all 0.18s ease;
}
.db-room.empty-state {
  background: var(--empty-room);
  border-color: var(--empty-border);
  opacity: 0.65;
}
.db-room.occupied-state {
  background: var(--occ-room);
  border-color: var(--occ-border);
  box-shadow: 0 0 0 3px var(--occ-glow), 0 3px 14px rgba(37,99,235,0.14);
  opacity: 1;
}
.db-room:hover {
  opacity: 1 !important;
  transform: scale(1.04);
  z-index: 10;
  box-shadow: 0 8px 24px rgba(0,0,0,0.25);
}
.db-room.occupied-state .room-num { color: var(--accent); }

/* Badges */
.count-badge {
  position: absolute;
  top: 5px; right: 5px;
  background: var(--accent);
  color: #fff;
  border-radius: 20px;
  padding: 1px 6px;
  font-family: var(--mono);
  font-size: 0.54rem;
  font-weight: 700;
  box-shadow: 0 2px 6px rgba(37,99,235,0.3);
}

/* User chips */
.user-chips {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-top: 3px;
  overflow: hidden;
  flex: 1;
}
.chip {
  background: rgba(37,99,235,0.1);
  border: 1px solid rgba(37,99,235,0.15);
  border-radius: 3px;
  padding: 1px 5px;
  font-size: 0.54rem;
  font-weight: 600;
  color: var(--accent);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.more-text { font-size: 0.51rem; color: var(--muted); padding-left: 1px; }

/* ─────────────────────────────────────────
   9. STRUCTURAL ELEMENTS (stairs, shafts…)
───────────────────────────────────────── */
.stair-block {
  background: var(--stair-bg);
  margin: 3px;
  border-radius: var(--r-s);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  font-family: var(--mono);
  font-size: 0.46rem;
  color: var(--stair-text);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  position: relative;
  overflow: hidden;
}
.stair-block::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    45deg, transparent, transparent 5px,
    rgba(0,0,0,0.07) 5px, rgba(0,0,0,0.07) 6px
  );
}
.stair-ico { font-size: 1.1rem; opacity: 0.55; position: relative; z-index: 1; }
.stair-lbl { position: relative; z-index: 1; text-align: center; line-height: 1.4; }

.shaft-col {
  background: #9aa5bc;
  margin: 3px;
  border-radius: var(--r-s);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  position: relative;
  overflow: hidden;
}
.shaft-col::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    90deg, transparent, transparent 3px,
    rgba(255,255,255,0.12) 3px, rgba(255,255,255,0.12) 4px
  );
}

.corr-h {
  background: var(--corridor);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.corr-h::before {
  content: attr(data-label);
  font-family: var(--mono);
  font-size: 0.52rem;
  color: #7a8899;
  text-transform: uppercase;
  letter-spacing: 2px;
  position: relative;
  z-index: 1;
}
.corr-h::after {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    90deg, transparent, transparent 26px,
    rgba(0,0,0,0.04) 26px, rgba(0,0,0,0.04) 27px
  );
}

.service-zone {
  margin: 3px;
  border-radius: var(--r-s);
  overflow: hidden;
  display: flex;
  flex-direction: row;
  gap: 0;
  background: var(--service-bg);
}
.sz-stair {
  background: var(--stair-bg);
  flex: 0 0 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  font-family: var(--mono);
  font-size: 0.44rem;
  color: var(--stair-text);
  text-transform: uppercase;
  letter-spacing: 0.7px;
  position: relative;
  overflow: hidden;
}
.sz-stair::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(45deg,transparent,transparent 4px,rgba(0,0,0,0.08) 4px,rgba(0,0,0,0.08) 5px);
}
.sz-stair span { font-size: 0.9rem; opacity: 0.55; position: relative; z-index: 1; }
.sz-stair-lbl { position: relative; z-index: 1; text-align: center; }
.sz-wc {
  flex: 0 0 28px;
  background: #bcc5d8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  font-family: var(--mono);
  font-size: 0.44rem;
  color: #5a6480;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  border-left: 1px solid rgba(0,0,0,0.1);
}
.sz-wc span { font-size: 0.85rem; }
.sz-open {
  flex: 1;
  background: #d0d8e8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 0.46rem;
  color: #6a7490;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  text-align: center;
  line-height: 1.4;
  border-left: 1px solid rgba(0,0,0,0.08);
  position: relative;
  overflow: hidden;
}
.sz-open::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(-45deg,transparent,transparent 6px,rgba(0,0,0,0.03) 6px,rgba(0,0,0,0.03) 7px);
}
.sz-open span { position: relative; z-index: 1; }

.storage-zone {
  margin: 3px;
  border-radius: var(--r-s);
  background: #c0c9d8;
  border: 1.5px dashed #9aa4b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 0.52rem;
  color: #6a7490;
  text-transform: uppercase;
  letter-spacing: 1px;
  text-align: center;
  line-height: 1.6;
  position: relative;
  overflow: hidden;
  min-height: 44px;
}
.storage-zone::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(45deg,transparent,transparent 8px,rgba(0,0,0,0.03) 8px,rgba(0,0,0,0.03) 9px);
}
.storage-zone span { position: relative; z-index: 1; }

.mini-shaft {
  margin: 3px;
  border-radius: 5px;
  background: #a8b2c6;
  min-height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 0.42rem;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  position: relative;
  overflow: hidden;
}
.mini-shaft::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(90deg,transparent,transparent 3px,rgba(255,255,255,0.1) 3px,rgba(255,255,255,0.1) 4px);
}
.mini-shaft span { position: relative; z-index: 1; color: #5a6680; font-size: 0.42rem; }

.east-wing-col {
  display: flex;
  flex-direction: column;
  margin: 3px;
  gap: 3px;
}
.east-wing-col .room { margin: 0; flex: 1; min-height: 0; }
.east-wing-col .stair-block { margin: 0; min-height: 38px; flex-shrink: 0; }
.east-wing-col .room.open-area-room {
  background: #cdd5e4;
  border-style: dashed;
  flex: 0.7;
}

/* ─────────────────────────────────────────
   10. LEGEND
───────────────────────────────────────── */
.legend {
  display: flex;
  gap: 18px;
  margin-top: 14px;
  flex-wrap: wrap;
  padding: 0 2px;
}
.leg {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: var(--mono);
  font-size: 0.58rem;
  color: rgba(255,255,255,0.32);
  letter-spacing: 0.4px;
}
.leg-box { width: 12px; height: 12px; border-radius: 3px; }
.leg-box.occ  { background: #fff; border: 2px solid var(--accent); }
.leg-box.emp  { background: var(--empty-room); border: 1.5px solid var(--empty-border); opacity: 0.7; }
.leg-box.stat { background: var(--static-room); border: 1.5px solid var(--static-border); }

/* ─────────────────────────────────────────
   11. MODAL (room detail)
───────────────────────────────────────── */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(5,10,20,0.7);
  backdrop-filter: blur(8px);
  z-index: 300;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.overlay.open { display: flex; }

.modal {
  background: var(--wall-mid);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--r-xl);
  padding: 26px;
  max-width: 380px;
  width: 100%;
  box-shadow: var(--shadow-xl), 0 0 0 1px rgba(37,99,235,0.1);
  animation: mIn var(--tr-mid);
}

@keyframes mIn {
  from { opacity:0; transform:scale(.88) translateY(12px); }
  to   { opacity:1; transform:scale(1) translateY(0); }
}

.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}
.m-room {
  font-family: var(--mono);
  font-size: 2rem;
  font-weight: 600;
  color: var(--accent-light);
  line-height: 1;
}
.m-sub { font-size: 0.7rem; color: var(--muted-light); margin-top: 4px; }

.m-close {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  width: 30px; height: 30px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 0.82rem;
  color: var(--muted-light);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--tr-fast);
  flex-shrink: 0;
}
.m-close:hover { background: rgba(239,68,68,0.15); border-color: var(--red); color: #fca5a5; }

.m-hr { border: none; border-top: 1px solid rgba(255,255,255,0.08); margin-bottom: 16px; }
.m-list { display: flex; flex-direction: column; gap: 10px; }
.m-row  { display: flex; align-items: center; gap: 12px; }

.m-av {
  width: 38px; height: 38px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(37,99,235,0.3);
}
.m-name { font-weight: 700; font-size: 0.88rem; color: #fff; }
.m-time { font-family: var(--mono); font-size: 0.62rem; color: var(--muted-light); margin-top: 2px; }
.m-empty { text-align: center; padding: 24px 0; color: var(--muted-light); font-size: 0.82rem; }
.m-empty-ico { font-size: 2rem; display: block; margin-bottom: 8px; }

/* ─────────────────────────────────────────
   12. FEATURE — ROOM HIGHLIGHT (search)
───────────────────────────────────────── */
@keyframes roomPulse {
  0%   { box-shadow: 0 0 0 0 rgba(37,99,235,.8); }
  60%  { box-shadow: 0 0 0 10px rgba(37,99,235,0); }
  100% { box-shadow: 0 0 0 0 rgba(37,99,235,0); }
}
.room-highlight {
  animation: roomPulse 1.1s ease-out infinite;
  border-color: var(--accent) !important;
  outline: 2.5px solid var(--accent);
  z-index: 20;
}

/* ─────────────────────────────────────────
   13. FEATURE — STALE BADGE (feature 4)
───────────────────────────────────────── */
.stale-room { border-color: var(--amber) !important; opacity: .75 !important; }
.stale-room .room-num { color: var(--amber) !important; }
.stale-badge {
  position: absolute; top: 5px; right: 5px;
  background: rgba(245,158,11,.15);
  border: 1px solid rgba(245,158,11,.5);
  border-radius: 4px;
  padding: 1px 5px;
  font-family: var(--mono);
  font-size: 0.48rem;
  color: var(--amber);
}

/* ─────────────────────────────────────────
   14. FEATURE — CAPACITY (feature 7)
───────────────────────────────────────── */
.over-capacity { border-color: var(--red) !important; }
.over-capacity .room-num { color: var(--red) !important; }
.cap-badge {
  position: absolute; bottom: 5px; right: 5px;
  background: rgba(239,68,68,.12);
  border: 1px solid rgba(239,68,68,.4);
  border-radius: 4px;
  padding: 1px 5px;
  font-family: var(--mono);
  font-size: 0.48rem;
  color: var(--red);
}

/* ─────────────────────────────────────────
   15. FEATURE — RESERVATIONS (feature 12)
───────────────────────────────────────── */
.res-tag {
  position: absolute; top: 0; left: 0; right: 0; z-index: 5;
  padding: 2px 5px;
  font-family: var(--mono);
  font-size: 0.44rem;
  font-weight: 700;
  text-align: center;
  border-radius: 5px 5px 0 0;
}
.res-exam   { background: rgba(185,28,28,.9); color: #fecaca; border-bottom: 1px solid rgba(252,165,165,.3); }
.res-clean  { background: rgba(21,128,61,.9); color: #bbf7d0; border-bottom: 1px solid rgba(134,239,172,.3); }
.res-reserv { background: rgba(161,98,7,.9);  color: #fde68a; border-bottom: 1px solid rgba(253,230,138,.3); }
.res-closed { background: rgba(71,85,105,.9); color: #cbd5e1; border-bottom: 1px solid rgba(203,213,225,.3); }

/* ─────────────────────────────────────────
   16. FEATURE — SPARKLINE (feature 9)
───────────────────────────────────────── */
.sparkline-wrap { margin-top: auto; padding-top: 3px; line-height: 0; }

/* ─────────────────────────────────────────
   17. FEATURE — HEATMAP (feature 3)
───────────────────────────────────────── */
.hm-cold { background: rgba(148,163,184,.3) !important; }
.hm-cool { background: rgba(16,185,129,.2)  !important; }
.hm-warm { background: rgba(245,158,11,.22) !important; }
.hm-hot  { background: rgba(239,68,68,.22)  !important; }

/* ─────────────────────────────────────────
   18. FEATURE — PATHFINDING BANNER (feat 10)
───────────────────────────────────────── */
.pf-banner {
  display: none;
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--wall);
  border: 1px solid rgba(255,255,255,0.12);
  color: #fff;
  border-radius: 14px;
  padding: 12px 22px;
  font-family: var(--mono);
  font-size: 0.72rem;
  z-index: 400;
  box-shadow: var(--shadow-xl);
  align-items: center;
  gap: 14px;
  white-space: nowrap;
  max-width: calc(100vw - 32px);
}
.pf-banner.visible { display: flex; }
.pf-status { color: var(--accent2); overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.pf-cancel {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  color: #fff;
  padding: 4px 11px;
  border-radius: var(--r-s);
  cursor: pointer;
  font-family: var(--mono);
  font-size: 0.62rem;
  flex-shrink: 0;
  transition: all var(--tr-fast);
}
.pf-cancel:hover { background: rgba(239,68,68,0.2); border-color: var(--red); }

@keyframes pathPulse { 0%,100%{opacity:1} 50%{opacity:.38} }
.pf-source { outline: 2.5px solid var(--accent) !important; border-color: var(--accent) !important; }
.pf-dest   { outline: 2.5px solid var(--green) !important; border-color: var(--green) !important; }
.pf-path   {
  outline: 2px dashed var(--amber) !important;
  border-color: var(--amber) !important;
  animation: pathPulse 1.2s ease-in-out infinite;
}

/* ─────────────────────────────────────────
   19. FEATURE — EMERGENCY ROLL CALL (feat 11)
───────────────────────────────────────── */
.em-overlay {
  position: fixed;
  inset: 0;
  background: rgba(3,7,18,0.97);
  z-index: 600;
  display: none;
  flex-direction: column;
}
.em-overlay.open { display: flex; }

.em-header {
  background: linear-gradient(90deg, #991b1b, #b91c1c);
  color: #fff;
  padding: 16px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  gap: 12px;
  flex-wrap: wrap;
}
.em-title {
  font-family: var(--mono);
  font-size: 1rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10px;
}
.em-hdr-btns { display: flex; gap: 8px; flex-shrink: 0; }
.em-btn {
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  color: #fff;
  padding: 6px 14px;
  border-radius: 8px;
  cursor: pointer;
  font-family: var(--mono);
  font-size: 0.66rem;
  font-weight: 500;
  transition: all var(--tr-fast);
  white-space: nowrap;
}
.em-btn:hover { background: rgba(255,255,255,0.22); }

.em-body {
  flex: 1;
  overflow-y: auto;
  padding: 20px 24px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  gap: 14px;
  align-content: start;
}
.em-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 12px;
  padding: 14px;
  transition: border-color var(--tr-fast);
}
.em-card:hover { border-color: rgba(239,68,68,0.3); }
.em-room-n {
  font-family: var(--mono);
  font-size: 1rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8px;
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.em-person {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 5px 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.em-person:last-child { border-bottom: none; }
.em-av {
  width: 28px; height: 28px;
  border-radius: 7px;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 0.56rem;
  font-weight: 700;
  color: #fff;
}
.em-uid { font-size: 0.77rem; color: rgba(255,255,255,.88); font-weight: 600; }
.em-ts  { font-family: var(--mono); font-size: 0.56rem; color: rgba(255,255,255,.35); }

.em-footer {
  background: rgba(0,0,0,0.5);
  padding: 12px 24px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  font-family: var(--mono);
  font-size: 0.65rem;
  color: rgba(255,255,255,0.38);
  border-top: 1px solid rgba(255,255,255,0.06);
}

@media print {
  .em-overlay { position: static !important; background: #fff !important; }
  .em-header  { background: #dc2626 !important; }
  .em-card    { background: #fff !important; border: 1px solid #ccc !important; break-inside: avoid; }
  .em-room-n, .em-uid { color: #000 !important; }
  body > *:not(.em-overlay) { display: none !important; }
}

/* ─────────────────────────────────────────
   20. FEATURE — 24H TIMELINE MODAL (feat 2)
───────────────────────────────────────── */
.tl-overlay {
  position: fixed;
  inset: 0;
  background: rgba(5,10,20,0.7);
  backdrop-filter: blur(8px);
  z-index: 500;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.tl-overlay.open { display: flex; }

.tl-modal {
  background: var(--wall-mid);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--r-xl);
  padding: 24px;
  max-width: 440px;
  width: 100%;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-xl);
  animation: mIn var(--tr-mid);
}
.tl-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14px;
}
.tl-title {
  font-family: var(--mono);
  font-size: 1rem;
  font-weight: 700;
  color: var(--accent-light);
}
.tl-sub { font-size: 0.67rem; color: var(--muted-light); margin-top: 3px; }
.tl-close {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  width: 28px; height: 28px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 0.82rem;
  color: var(--muted-light);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--tr-fast);
  flex-shrink: 0;
}
.tl-close:hover { background: rgba(239,68,68,0.15); color: #fca5a5; }
.tl-body { flex: 1; overflow-y: auto; }

.tl-entry {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 9px 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  position: relative;
}
.tl-entry:last-child { border-bottom: none; }
.tl-dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  background: var(--accent);
  margin-top: 4px;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 0 6px rgba(37,99,235,0.5);
}
.tl-line {
  position: absolute;
  left: 4px;
  top: 14px;
  bottom: -9px;
  width: 2px;
  background: rgba(255,255,255,0.07);
}
.tl-entry:last-child .tl-line { display: none; }
.tl-info { flex: 1; }
.tl-name { font-weight: 700; font-size: 0.84rem; color: #fff; }
.tl-time { font-family: var(--mono); font-size: 0.6rem; color: var(--muted-light); margin-top: 2px; }
.tl-empty, .tl-loading {
  text-align: center;
  padding: 32px 0;
  color: var(--muted-light);
  font-size: 0.8rem;
  font-family: var(--mono);
}

/* ─────────────────────────────────────────
   21. FEATURE — CONTEXT MENU (feat 12)
───────────────────────────────────────── */
.ctx-menu {
  position: fixed;
  z-index: 700;
  background: var(--wall);
  border: 1.5px solid rgba(255,255,255,0.1);
  border-radius: var(--r-m);
  padding: 5px 0;
  box-shadow: var(--shadow-xl);
  display: none;
  min-width: 190px;
  animation: mIn .14s ease-out;
}
.ctx-menu.open { display: block; }
.ctx-item {
  padding: 8px 14px;
  cursor: pointer;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.78);
  display: flex;
  align-items: center;
  gap: 9px;
  transition: background var(--tr-fast);
}
.ctx-item:hover { background: rgba(37,99,235,0.18); color: #fff; }
.ctx-item.ctx-danger:hover { background: rgba(239,68,68,0.15); color: #fca5a5; }
.ctx-sep { height: 1px; background: rgba(255,255,255,0.07); margin: 4px 0; }
.ctx-lbl {
  padding: 4px 14px 5px;
  font-family: var(--mono);
  font-size: 0.54rem;
  color: var(--muted-light);
  text-transform: uppercase;
  letter-spacing: 1.2px;
}

/* ─────────────────────────────────────────
   22. SCROLL HINT FOR FLOOR PLAN (mobile)
───────────────────────────────────────── */
.fp-scroll-hint {
  display: none;
  font-family: var(--mono);
  font-size: 0.6rem;
  color: rgba(255,255,255,0.3);
  text-align: center;
  padding: 6px;
  letter-spacing: 0.5px;
}

/* ─────────────────────────────────────────
   23. RESPONSIVE BREAKPOINTS
───────────────────────────────────────── */

/* ── Large Desktop (≥ 1280px) ── */
@media (min-width: 1280px) {
  .navbar { padding: 0 36px; }
  .topbar { padding: 14px 36px; }
  .toolbar { padding: 9px 36px; }
  .fp-wrapper { padding: 28px 24px 40px; }
  .building { padding: 20px; }
}

/* ── Laptop (1024px – 1279px) ── */
@media (max-width: 1279px) and (min-width: 1024px) {
  .building { max-width: 980px; }
  .search-bar-wrap { max-width: 240px; }
}

/* ── Tablet (768px – 1023px) ── */
@media (max-width: 1023px) and (min-width: 768px) {
  .navbar { padding: 0 18px; }
  .topbar {
    padding: 10px 18px;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }
  .building-info { display: flex; align-items: baseline; justify-content: space-between; }
  .search-bar-wrap { max-width: 100%; min-width: 0; }
  .stats { justify-content: space-between; width: 100%; }
  .toolbar { padding: 8px 18px; flex-direction: column; align-items: stretch; gap: 8px; }
  .occ-bar-outer { max-width: 100%; }
  .tool-btns { justify-content: flex-start; }
  .fp-wrapper { padding: 16px 12px; }
  .building { max-width: 100%; min-width: 620px; }
  .fp-scroll-hint { display: block; }
}

/* ── Mobile (< 768px) ── */
@media (max-width: 767px) {
  .navbar {
    padding: 0 14px;
    height: 50px;
  }
  .logo { font-size: 0.88rem; }
  .live-pill { padding: 3px 9px; font-size: 0.6rem; }
  .live-pill span { display: none; } /* hide LIVE text, keep dot */
  .nav-btn { padding: 5px 10px; font-size: 0.72rem; }

  .topbar {
    padding: 10px 14px;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }
  .building-info h2 { font-size: 0.85rem; }
  .search-bar-wrap { max-width: 100%; min-width: 0; flex: none; }
  .stats {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto;
    align-items: center;
    gap: 0;
    width: 100%;
  }
  .stat { flex: 1; }
  .stat-n { font-size: 1.1rem; }
  .refresh-btn { display: none; } /* moved to toolbar */

  .toolbar {
    padding: 8px 14px;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }
  .occ-bar-outer { max-width: 100%; }
  .tool-btns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .tool-btn {
    justify-content: center;
    padding: 8px 10px;
    font-size: 0.64rem;
  }

  .fp-wrapper {
    padding: 12px 0 24px;
    justify-content: flex-start;
  }
  .fp-scroll-hint { display: block; }
  .building {
    border-radius: 0;
    min-width: 600px;
    padding: 12px;
    box-shadow: none;
  }
  /* Wrap building in a scrollable div feel — body scroll does it */

  /* Modals go full-width on mobile */
  .modal, .tl-modal {
    border-radius: var(--r-l);
    padding: 20px 18px;
    max-width: 100%;
  }
  .overlay, .tl-overlay { padding: 12px; align-items: flex-end; }
  .modal { border-radius: 20px 20px 14px 14px; }
  .tl-modal { border-radius: 20px 20px 14px 14px; max-height: 88vh; }

  /* Emergency roll call */
  .em-body { grid-template-columns: 1fr 1fr; padding: 14px; gap: 10px; }
  .em-header { padding: 12px 16px; }
  .em-title { font-size: 0.85rem; }
  .em-footer { padding: 10px 16px; }

  /* Pathfinding banner */
  .pf-banner {
    bottom: 14px;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    text-align: center;
  }

  /* Context menu */
  .ctx-menu { min-width: 170px; }
}

/* ── Very small mobile (< 400px) ── */
@media (max-width: 399px) {
  .em-body { grid-template-columns: 1fr; }
  .stats {
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
  }
  .sep { display: none; }
  .building { min-width: 560px; }
}

/* ─────────────────────────────────────────
   24. SCROLLBAR STYLING (webkit)
───────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: rgba(255,255,255,0.04); }
::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.25); }

/* ─────────────────────────────────────────
   25. FOCUS ACCESSIBILITY
───────────────────────────────────────── */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 4px;
}
button:focus-visible { box-shadow: 0 0 0 3px rgba(37,99,235,0.35); }

