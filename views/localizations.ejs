<!-- ── Navbar ── -->
<nav class="navbar">
  <div class="logo">Indoor<span>Locate</span></div>
  <div class="nav-right">
    <div class="live-pill">
      <div class="live-dot" id="liveDot"></div>
      <span id="liveText">LIVE</span>
    </div>
    <button class="nav-btn" onclick="location.href='/'">← Home</button>
  </div>
</nav>

<!-- ── Stats + Search bar ── -->
<div class="topbar">
  <div class="building-info">
    <h2 id="floorTitle">Shivaji Bhavan — 3rd Floor</h2>
    <p id="lastUpdated">// fetching live data...</p>
  </div>

  <!-- ── Find-a-Person Search ── -->
