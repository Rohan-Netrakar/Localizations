<!-- ── 24h Timeline Modal ── -->
<div class="tl-overlay" id="tlOverlay" onclick="if(event.target===this)closeTimeline()">
  <div class="tl-modal">
    <div class="tl-head">
      <div>
        <div class="tl-title" id="tlTitle">Room — · History</div>
        <div class="tl-sub">Last 24 hours of activity</div>
      </div>
      <button class="tl-close" onclick="closeTimeline()">✕</button>
