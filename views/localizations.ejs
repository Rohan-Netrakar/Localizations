<div class="overlay" id="overlay" onclick="onBg(event)">
  <div class="modal">
    <div class="modal-head">
      <div>
        <div class="m-room" id="mRoom">—</div>
        <div class="m-sub" id="mSub">3rd Floor · Shivaji Bhavan</div>
      </div>
      <div style="display:flex;gap:6px;align-items:flex-start">
        <button class="nav-btn" id="btnModalHistory"
          style="padding:4px 10px;font-size:0.63rem;background:#f0f5ff;border-color:#bfdbfe;color:var(--accent);"
          onclick="openTimelineForCurrentRoom()">📅 History</button>
        <button class="m-close" onclick="closeModal()">✕</button>
      </div>
    </div>
    <hr class="m-hr">
    <div class="m-list" id="mList"></div>
  </div>
</div>

