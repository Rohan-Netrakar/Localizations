<script>
  /* ── All trackable room numbers for this floor ── */
  const DB_ROOMS = [
    '301','302','303','304','305','306','307','309','310','311','313','314',
    '316','317','319','320','321','322','323','324','326',
    '328','329','330','331','332','333','334','335','336','337'
  ];

  let locationMap = {};
  let allRooms    = [];
  let socket      = null;

  /* ── Helpers ── */
  function timeAgo(ts){
    if(!ts) return '—';
    // PostgreSQL TIMESTAMP (no timezone) comes back as "2026-03-07 11:21:14.829885"
    // with no timezone marker. Both server and DB run UTC, so we append Z to
    // force correct UTC parsing — otherwise the browser treats it as local time
    // and shows a 5h30m offset for IST users.
    let s = String(ts).trim().replace(' ', 'T');
    if(!s.endsWith('Z') && !s.includes('+') && !s.match(/[-+]\d{2}:\d{2}$/)) s += 'Z';
    const d = Math.floor((Date.now() - new Date(s)) / 1000);
    if(d < 5)   return 'just now';
    if(d < 60)  return d + 's ago';
    if(d < 3600) return Math.floor(d/60) + 'm ago';
    return Math.floor(d/3600) + 'h ago';
  }
  function initials(uid){ return uid.substring(0,2).toUpperCase(); }

  /* ── Match room by name or embedded 3-digit number ── */
  function usersInRoom(roomNum){
    if(locationMap[roomNum]) return locationMap[roomNum];
    // fallback: search by embedded number in room_name
    for(const [key,arr] of Object.entries(locationMap)){
      const m=key.match(/\b(\d{3})\b/);
      if(m && m[1]===roomNum) return arr;
    }
    return [];
  }

  /* ── Update a single room card ── */
  function updateRoomCard(roomNum){
    const el=document.getElementById('room-'+roomNum);
    if(!el) return;
    const users=usersInRoom(roomNum);
    const occ=users.length>0;
    const chips=document.getElementById('chips-'+roomNum);

    el.className=el.className.replace(/occupied-state|empty-state/g,'').trim();
    el.classList.add(occ?'occupied-state':'empty-state');

    let badge=el.querySelector('.count-badge');
    if(occ){
      if(!badge){ badge=document.createElement('div'); badge.className='count-badge'; el.appendChild(badge); }
      badge.textContent=users.length;
    } else {
      if(badge) badge.remove();
    }

    if(chips){
      const MAX=2;
      chips.innerHTML=occ
        ? users.slice(0,MAX).map(u=>`<div class="chip">${u.user_id}</div>`).join('')
          +(users.length>MAX?`<div class="more-text">+${users.length-MAX} more</div>`:'')
        : '';
    }
  }

  /* ── Modal ── */
  function openModal(roomNum){
    const users=usersInRoom(roomNum);
    document.getElementById('mRoom').textContent='Room '+roomNum;
    const list=document.getElementById('mList');
    if(!users.length){
      list.innerHTML=`<div class="m-empty"><span class="m-empty-ico">🚪</span>This room is currently empty</div>`;
    } else {
      list.innerHTML=users.map(u=>`
        <div class="m-row">
          <div class="m-av">${initials(u.user_id)}</div>
          <div>
            <div class="m-name">${u.user_id}</div>
            <div class="m-time">Last seen ${timeAgo(u.last_seen)}</div>
          </div>
        </div>`).join('');
    }
    document.getElementById('overlay').classList.add('open');
  }
  function onBg(e){ if(e.target===document.getElementById('overlay')) closeModal(); }
  function closeModal(){ document.getElementById('overlay').classList.remove('open'); }

  /* ── Build locationMap from API response ── */
  function applyUsers(users){
    locationMap={};
    users.forEach(u=>{
      const name=u.room_name||'';
      if(!locationMap[name]) locationMap[name]=[];
      locationMap[name].push(u);
      // also key by embedded 3-digit number
      const m=name.match(/\b(\d{3})\b/);
      if(m && m[1]!==name){
        if(!locationMap[m[1]]) locationMap[m[1]]=[];
        if(!locationMap[m[1]].find(x=>x.user_id===u.user_id)) locationMap[m[1]].push(u);
      }
    });
  }

  /* ── Fetch from API ── */
  async function fetchData(){
    try{
      const [r1,r2]=await Promise.all([fetch('/api/rooms'),fetch('/api/all-locations')]);
      const rd=await r1.json(), ld=await r2.json();
      if(rd.success) allRooms=rd.rooms;
      if(ld.success) applyUsers(ld.users);

      DB_ROOMS.forEach(updateRoomCard);

      const totalPeople=Object.values(locationMap).reduce((s,a)=>s+a.length,0);
      const occRooms=DB_ROOMS.filter(r=>usersInRoom(r).length>0).length;
      document.getElementById('sPeople').textContent=totalPeople;
      document.getElementById('sOcc').textContent=occRooms;
      document.getElementById('sTotal').textContent=allRooms.length||DB_ROOMS.length;
      document.getElementById('lastUpdated').textContent='// updated '+new Date().toLocaleTimeString();
      document.getElementById('liveDot').className='live-dot';
      document.getElementById('liveText').textContent='LIVE';
    } catch(err){
      console.error(err);
      document.getElementById('liveDot').className='live-dot err';
      document.getElementById('liveText').textContent='ERROR';
    }
  }

  /* ── Socket.io for instant updates ── */
  function startSocket(){
    try{
      socket=io({transports:['websocket'],reconnectionDelay:2000});
      socket.on('connect',()=>{ document.getElementById('liveDot').className='live-dot'; });
      socket.on('disconnect',()=>{ document.getElementById('liveDot').className='live-dot err'; });
      socket.on('location-update',data=>{
        /* Remove user from every room first (they moved) */
        for(const key of Object.keys(locationMap)){
          locationMap[key]=locationMap[key].filter(u=>u.user_id!==data.user_id);
        }
        /* Insert into new room, keyed both ways */
        const room=data.room_name||'';
        if(!locationMap[room]) locationMap[room]=[];
        locationMap[room].push(data);
        const m=room.match(/\b(\d{3})\b/);
        if(m && m[1]!==room){
          if(!locationMap[m[1]]) locationMap[m[1]]=[];
          locationMap[m[1]].push(data);
        }
        DB_ROOMS.forEach(updateRoomCard);
        const tp=Object.values(locationMap).flat()
          .filter((u,i,a)=>a.findIndex(x=>x.user_id===u.user_id)===i).length;
        const oc=DB_ROOMS.filter(r=>usersInRoom(r).length>0).length;
        document.getElementById('sPeople').textContent=tp;
        document.getElementById('sOcc').textContent=oc;
      });
    } catch(e){
      console.warn('Socket.io unavailable, falling back to polling');
    }
  }

  /* ════════════════════════════════════════════
     FIND-A-PERSON SEARCH
     ════════════════════════════════════════════ */
  let highlightedRoomEl = null;   // currently pulsing room card
  let highlightTimer    = null;   // auto-clear timeout

  const searchInput    = document.getElementById('searchInput');
  const searchDropdown = document.getElementById('searchDropdown');
  const searchBanner   = document.getElementById('searchBanner');
  const searchClear    = document.getElementById('searchClear');

  /* ── Build a flat list of every known user from locationMap ── */
  function getAllUsers(){
    const seen = new Set();
    const out  = [];
    for(const [roomKey, users] of Object.entries(locationMap)){
      /* Only iterate over numeric-keyed entries to avoid duplicates */
      if(!/^\d{3}$/.test(roomKey) && !roomKey.match(/^\d{3}$/)) {
        /* it's a room_name string key — use it */
      }
      for(const u of users){
        if(!seen.has(u.user_id)){
          seen.add(u.user_id);
          out.push(u);
        }
      }
    }
    return out;
  }

  /* ── Find which room number a user is in (for scrolling) ── */
  function roomNumForUser(u){
    const name = u.room_name || '';
    /* Direct match: name is exactly '303' */
    if(document.getElementById('room-' + name)) return name;
    /* Embedded match: name is 'Room 303' etc */
    const m = name.match(/\b(\d{3})\b/);
    if(m && document.getElementById('room-' + m[1])) return m[1];
    /* Search locationMap keys */
    for(const [key, arr] of Object.entries(locationMap)){
      if(arr.find(x => x.user_id === u.user_id)){
        const k2 = key.match(/\b(\d{3})\b/);
        if(k2 && document.getElementById('room-' + k2[1])) return k2[1];
        if(document.getElementById('room-' + key)) return key;
      }
    }
    return null;
  }

  /* ── Highlight (pulse) a room card and scroll to it ── */
  function highlightRoom(roomNum){
    /* Clear any previous highlight */
    if(highlightedRoomEl){
      highlightedRoomEl.classList.remove('room-highlight');
      highlightedRoomEl = null;
    }
    clearTimeout(highlightTimer);

    const el = document.getElementById('room-' + roomNum);
    if(!el) return;

    highlightedRoomEl = el;
    el.classList.add('room-highlight');
    el.scrollIntoView({ behavior:'smooth', block:'center', inline:'center' });

    /* Auto-remove pulse after 6 seconds */
    highlightTimer = setTimeout(()=>{
      el.classList.remove('room-highlight');
      highlightedRoomEl = null;
    }, 6000);
  }

  /* ── Show the result banner ── */
  function showBanner(user, roomNum){
    const name = user.room_name || roomNum || '?';
    searchBanner.className = 'search-result-banner found';
    searchBanner.innerHTML =
      '<span class="srb-icon">📍</span>' +
      '<span class="srb-text"><strong>' + escHtml(user.user_id) + '</strong>' +
        ' is in <strong>Room ' + escHtml(roomNum||name) + '</strong>' +
        ' &nbsp;·&nbsp; ' + timeAgo(user.last_seen) + '</span>' +
      '<button class="srb-goto" onclick="highlightRoom(\'' + escHtml(roomNum) + '\')">Go →</button>';
  }

  function showNotFound(query){
    searchBanner.className = 'search-result-banner notfound';
    searchBanner.innerHTML =
      '<span class="srb-icon">🚫</span>' +
      '<span class="srb-text"><strong>' + escHtml(query) + '</strong> is not on this floor right now</span>';
  }

  function hideBanner(){
    searchBanner.className = 'search-result-banner';
    searchBanner.innerHTML = '';
  }

  /* ── Render the dropdown suggestions ── */
  function renderDropdown(query){
    const q = query.trim().toLowerCase();
    searchDropdown.innerHTML = '';

    if(!q){ searchDropdown.classList.remove('open'); return; }

    const all = getAllUsers();
    const matches = all.filter(u => u.user_id.toLowerCase().includes(q));

    if(!matches.length){
      searchDropdown.innerHTML = '<div class="sd-empty">No one found matching "' + escHtml(query) + '"</div>';
      searchDropdown.classList.add('open');
      return;
    }

    /* Cap at 6 suggestions */
    matches.slice(0, 6).forEach(u => {
      const roomNum = roomNumForUser(u);
      const roomLabel = roomNum ? 'Room ' + roomNum : (u.room_name || '?');
      const div = document.createElement('div');
      div.className = 'sd-item';
      div.innerHTML =
        '<div class="sd-av">' + escHtml(initials(u.user_id)) + '</div>' +
        '<div class="sd-info">' +
          '<div class="sd-name">' + escHtml(u.user_id) + '</div>' +
          '<div class="sd-room">' + escHtml(roomLabel) + '</div>' +
        '</div>' +
        '<div class="sd-time">' + timeAgo(u.last_seen) + '</div>';

      div.addEventListener('mousedown', function(e){
        /* mousedown fires before blur; prevent input blur hiding dropdown */
        e.preventDefault();
        selectUser(u, roomNum);
      });
      searchDropdown.appendChild(div);
    });

    searchDropdown.classList.add('open');
  }

  /* ── Called when user picks someone (click or Enter) ── */
  function selectUser(user, roomNum){
    searchInput.value = user.user_id;
    searchClear.classList.add('visible');
    searchDropdown.classList.remove('open');

    if(roomNum){
      showBanner(user, roomNum);
      highlightRoom(roomNum);
    } else {
      showNotFound(user.user_id);
    }
  }

  /* ── Clear everything ── */
  function clearSearch(){
    searchInput.value = '';
    searchClear.classList.remove('visible');
    searchDropdown.classList.remove('open');
    hideBanner();
    if(highlightedRoomEl){
      highlightedRoomEl.classList.remove('room-highlight');
      highlightedRoomEl = null;
    }
    clearTimeout(highlightTimer);
    searchInput.focus();
  }

  /* ── Sanitise strings inserted into innerHTML ── */
  function escHtml(s){
    return String(s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ── Input events ── */
  searchInput.addEventListener('input', function(){
    const q = this.value;
    searchClear.classList.toggle('visible', q.length > 0);
    hideBanner();
    renderDropdown(q);
  });

  searchInput.addEventListener('keydown', function(e){
    if(e.key === 'Escape'){ clearSearch(); return; }
    if(e.key === 'Enter'){
      const q = this.value.trim();
      if(!q) return;
      searchDropdown.classList.remove('open');
      /* Find best match */
      const all = getAllUsers();
      /* Exact match first, then partial */
      const exact   = all.find(u => u.user_id.toLowerCase() === q.toLowerCase());
      const partial = all.find(u => u.user_id.toLowerCase().includes(q.toLowerCase()));
      const user    = exact || partial;
      if(user){
        const roomNum = roomNumForUser(user);
        selectUser(user, roomNum);
      } else {
        hideBanner();
        showNotFound(q);
      }
    }
  });

  /* Close dropdown when clicking outside */
  document.addEventListener('click', function(e){
    if(!document.getElementById('searchWrap').contains(e.target)){
      searchDropdown.classList.remove('open');
    }
  });


  startSocket();
  setInterval(()=>{ if(!socket||!socket.connected) fetchData(); }, 8000);

  /* ── Visibility API ── */
  document.addEventListener('visibilitychange',()=>{ if(!document.hidden) fetchData(); });
</script>
</body>
</html>
