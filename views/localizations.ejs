   13  Floor Navigation Bar
   14  Building Shell & Wrapper
   15  Floor-Plan Grid
   16  Room Cards
   17  Room States
   18  Pathfinding States
   19  Heatmap States
   20  Stale / Over-capacity
   21  Room Badges
   22  Reservation Tags
   23  User Chips
   24  Sparklines
   25  Structural Elements
   26  Lift Shaft Interactive
   27  Legend
   28  Room Detail Modal
   29  24h Timeline Modal
   30  Emergency Roll-Call
   31  Pathfinding Banner
   32  Lift Popup
   33  Context Menu
   34  Scrollbar
   35  Focus / A11y
   36  Keyframe Animations
   37  Utilities
   38  Responsive
   39  Print
   ═══════════════════════════════════════════════════════════════════ */


/* ─────────────────────── 01  RESET ──────────────────────────────── */
*,
*::before,
*::after { box-sizing: border-box; margin: 0; padding: 0; }
html     { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; -webkit-tap-highlight-color: transparent; }
body     { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
button   { cursor: pointer; font: inherit; background: none; border: none; }
a        { color: inherit; text-decoration: none; }
img, svg { display: block; max-width: 100%; }


/* ─────────────────── 02  DESIGN TOKENS ──────────────────────────── */
:root {
  /* Base palette */
  --col-bg:           #07111f;
  --col-surface-0:    #0b1627;
  --col-surface-1:    #0f1c30;
  --col-surface-2:    #132239;
  --col-surface-3:    #182843;
  --col-surface-4:    #1c2e4a;
  --col-border:       rgba(255,255,255,.07);
  --col-border-light: rgba(255,255,255,.13);

  /* Accent */
  --col-accent:       #2563eb;
  --col-accent-h:     #1a51d0;
  --col-accent-l:     #3b82f6;
  --col-accent-xl:    #60a5fa;
  --col-accent-dim:   rgba(37,99,235,.09);
  --col-accent-glow:  rgba(37,99,235,.28);
  --col-accent2:      #06b6d4;

  /* Semantic */
  --col-green:        #10b981;
  --col-green-dim:    rgba(16,185,129,.12);
  --col-green-border: rgba(16,185,129,.32);
  --col-amber:        #f59e0b;
  --col-amber-dim:    rgba(245,158,11,.12);
  --col-amber-border: rgba(245,158,11,.36);
  --col-red:          #ef4444;
  --col-red-dim:      rgba(239,68,68,.12);
  --col-red-border:   rgba(239,68,68,.36);

  /* Text */
  --text-primary:   #f0f5fc;
  --text-secondary: #90a3bf;
  --text-tertiary:  #5a7090;

  /* Floor-plan surfaces */
  --fp-corridor:     #bcc8d8;
  --fp-room-empty:   #e6ecf7;
  --fp-room-border:  #b0bad2;
  --fp-room-occ:     #ffffff;
  --fp-room-occ-bdr: #2563eb;
  --fp-room-occ-glow:rgba(37,99,235,.16);
  --fp-room-static:  #cdd5e6;
  --fp-room-stat-bdr:#a2adc4;
  --fp-stair-bg:     #a2adc4;
  --fp-stair-text:   #48547a;
  --fp-shaft-bg:     #98a4bc;
  --fp-service-bg:   #c6cedf;
  --fp-storage-bg:   #bec8d8;
  --fp-mini-shaft:   #a6b0c4;

  /* ── CRITICAL ALIASES ───────────────────────────────────────────
     These are used in HTML inline styles and MUST exist here.
     Without them those elements render broken.
  ───────────────────────────────────────────────────────────────── */
  --corridor: #bcc8d8;                                   /* = --fp-corridor  */
  --mono:     'IBM Plex Mono','Fira Code',monospace;     /* = --font-mono    */
  --accent:   #2563eb;                                   /* = --col-accent   */

  /* Typography */
  --font-sans: 'Outfit',system-ui,-apple-system,sans-serif;
  --font-mono: 'IBM Plex Mono','Fira Code',monospace;

  --text-2xs:  .60rem;
  --text-xs:   .68rem;
  --text-sm:   .77rem;
  --text-base: .875rem;
  --text-lg:   1rem;
  --text-xl:   1.125rem;
  --text-2xl:  1.5rem;
  --text-3xl:  2rem;

  --leading-tight:  1.20;
  --leading-snug:   1.40;
  --leading-normal: 1.60;

  /* Spacing */
  --sp-1:4px; --sp-2:8px; --sp-3:12px; --sp-4:16px;
  --sp-5:20px; --sp-6:24px; --sp-8:32px; --sp-10:40px;

  /* Radii */
  --r-xs:4px; --r-sm:7px; --r-md:10px; --r-lg:14px;
  --r-xl:18px; --r-2xl:24px; --r-full:9999px;

  /* Shadows */
  --shadow-xs: 0 1px 3px rgba(0,0,0,.22);
  --shadow-sm: 0 2px 8px rgba(0,0,0,.28);
  --shadow-md: 0 4px 18px rgba(0,0,0,.34), 0 1px 4px rgba(0,0,0,.20);
  --shadow-lg: 0 12px 40px rgba(0,0,0,.46), 0 2px 8px rgba(0,0,0,.28);
  --shadow-xl: 0 24px 64px rgba(0,0,0,.56), 0 4px 14px rgba(0,0,0,.30);
  --shadow-glow-blue: 0 0 20px rgba(37,99,235,.42), 0 0 6px rgba(37,99,235,.22);

  /* Motion */
  --ease-out-expo: cubic-bezier(0.16,1,0.3,1);
  --ease-spring:   cubic-bezier(0.34,1.56,0.64,1);
  --ease-in-out:   cubic-bezier(0.4,0,0.2,1);
  --dur-fast:  .11s;
  --dur-base:  .20s;
  --dur-slow:  .34s;
  --dur-enter: .26s;

  /* Z-index */
  --z-raised:  10;
  --z-nav:    200;
  --z-banner: 400;
  --z-overlay:300;
  --z-modal:  500;
  --z-lift:   550;
  --z-em:     600;
  --z-ctx:    700;
}


/* ─────────────────────── 03  BASE ───────────────────────────────── */
html { font-size: 16px; }
body {
  font-family: var(--font-sans);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  color: var(--text-primary);
  background-color: var(--col-bg);
  background-image:
    radial-gradient(ellipse 80% 50% at 12% -8%,  rgba(37,99,235,.11) 0%, transparent 55%),
    radial-gradient(ellipse 60% 45% at 92% 108%, rgba(6,182,212,.07)  0%, transparent 55%);
  min-height: 100vh;
}


/* ─────────────────────── 04  NAVBAR ─────────────────────────────── */
.navbar {
  position: sticky;
  top: 0;
  z-index: var(--z-nav);
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--sp-6);
  background: rgba(10,18,34,.92);
  border-bottom: 1px solid var(--col-border);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  box-shadow: 0 1px 0 rgba(255,255,255,.04), 0 4px 24px rgba(0,0,0,.40);
}
.navbar::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg,rgba(255,255,255,.028) 0%,transparent 100%);
  pointer-events: none;
}

.logo {
  font-family: var(--font-mono);
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: 1.5px;
  color: var(--text-primary);
  user-select: none;
  position: relative;
  z-index: 1;
  transition: opacity var(--dur-fast);
}
.logo:hover { opacity: .82; }
.logo span  { color: var(--col-accent2); }

.nav-right {
  display: flex;
  align-items: center;
  gap: 10px;
  position: relative;
  z-index: 1;
}


/* ─────────────────────── 05  LIVE PILL ──────────────────────────── */
.live-pill {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 5px 13px;
  border-radius: var(--r-full);
  background: var(--col-green-dim);
  border: 1px solid var(--col-green-border);
  font-family: var(--font-mono);
  font-size: var(--text-2xs);
  font-weight: 500;
  color: var(--col-green);
  letter-spacing: .8px;
  user-select: none;
}
.live-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--col-green);
  flex-shrink: 0;
  box-shadow: 0 0 7px var(--col-green);
  animation: livePulse 2.2s ease-in-out infinite;
}
.live-dot.err {
  background: var(--col-red);
  box-shadow: 0 0 7px var(--col-red);
  animation: none;
}


/* ─────────────────────── 06  NAV BUTTONS ────────────────────────── */
.nav-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  padding: 6px 15px;
  border-radius: var(--r-sm);
  background: rgba(255,255,255,.055);
  border: 1px solid var(--col-border-light);
  color: rgba(255,255,255,.78);
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  font-weight: 500;
  white-space: nowrap;
  transition:
    background var(--dur-fast), border-color var(--dur-fast),
    color var(--dur-fast), transform var(--dur-fast), box-shadow var(--dur-fast);
}
.nav-btn:hover  { background: rgba(255,255,255,.10); border-color: rgba(255,255,255,.22); color: #fff; transform: translateY(-1px); box-shadow: var(--shadow-sm); }
.nav-btn:active { transform: translateY(0); box-shadow: none; }


/* ─────────────────────── 07  TOPBAR ─────────────────────────────── */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-3);
  padding: 12px var(--sp-6);
  background: var(--col-surface-2);
  border-bottom: 1px solid var(--col-border);
}
.building-info h2 {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--text-primary);
  line-height: var(--leading-tight);
  letter-spacing: .15px;
}
.building-info p {
  font-family: var(--font-mono);
  font-size: var(--text-2xs);
  color: var(--text-secondary);
  margin-top: 4px;
}
.sep { width: 1px; height: 26px; background: var(--col-border-light); flex-shrink: 0; }


/* ─────────────────────── 08  SEARCH ─────────────────────────────── */
.search-bar-wrap {
  position: relative;
  flex: 1;
  max-width: 290px;
  min-width: 185px;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: 7px 11px 7px 14px;
  background: rgba(255,255,255,.042);
  border: 1.5px solid rgba(255,255,255,.09);
  border-radius: var(--r-lg);
  transition: border-color var(--dur-fast), background var(--dur-fast), box-shadow var(--dur-fast);
}
.search-bar-wrap:focus-within {
  background: rgba(255,255,255,.07);
  border-color: var(--col-accent);
  box-shadow: 0 0 0 3px rgba(37,99,235,.18);
}
.search-icon { flex-shrink: 0; font-size: .82rem; opacity: .52; transition: opacity var(--dur-fast); }
.search-bar-wrap:focus-within .search-icon { opacity: .88; }
.search-input {
  flex: 1; min-width: 0;
  border: none; outline: none;
  background: transparent;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--text-primary);
  caret-color: var(--col-accent-l);
}
.search-input::placeholder { color: rgba(255,255,255,.26); }
.search-clear {
  flex-shrink: 0; display: none;
  align-items: center; justify-content: center;
  width: 18px; height: 18px;
  border-radius: 50%;
  background: rgba(255,255,255,.08);
  color: rgba(255,255,255,.40);
  font-size: .68rem;
  transition: background var(--dur-fast), color var(--dur-fast);
}
.search-clear.visible { display: flex; }
.search-clear:hover   { background: var(--col-red-dim); color: var(--col-red); }

.search-dropdown {
  position: absolute;
  top: calc(100% + 7px); left: 0; right: 0;
  display: none;
  background: var(--col-surface-1);
  border: 1.5px solid var(--col-border-light);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-xl);
  z-index: var(--z-modal);
  overflow: hidden;
  animation: dropIn var(--dur-enter) var(--ease-out-expo);
}
.search-dropdown.open { display: block; }

.sd-item {
  display: flex; align-items: center; gap: var(--sp-2);
  padding: 11px 14px; cursor: pointer;
  border-bottom: 1px solid rgba(255,255,255,.04);
  transition: background var(--dur-fast);
}
.sd-item:last-child { border-bottom: none; }
.sd-item:hover      { background: rgba(37,99,235,.12); }

.sd-av {
  width: 32px; height: 32px;
  border-radius: var(--r-sm); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--col-accent), var(--col-accent2));
  font-family: var(--font-mono); font-size: var(--text-2xs);
  font-weight: 700; color: #fff;
  box-shadow: 0 2px 8px rgba(37,99,235,.30);
}
.sd-info { flex: 1; min-width: 0; }
.sd-name { font-size: var(--text-sm); font-weight: 700; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sd-room { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--col-accent2); margin-top: 1px; }
.sd-time { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--text-secondary); flex-shrink: 0; }
.sd-empty { padding: 16px; text-align: center; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary); }

.search-result-banner {
  position: absolute;
  top: calc(100% + 7px); left: 0; right: 0;
  display: none; align-items: center; gap: var(--sp-2);
  padding: 10px 14px; border-radius: var(--r-lg);
  font-family: var(--font-mono); font-size: var(--text-xs);
  z-index: var(--z-modal);
  animation: dropIn var(--dur-enter) var(--ease-out-expo);
}
.search-result-banner.found    { display: flex; background: rgba(37,99,235,.14); border: 1.5px solid rgba(37,99,235,.32); color: #93c5fd; }
.search-result-banner.notfound { display: flex; background: rgba(239,68,68,.10); border: 1.5px solid rgba(239,68,68,.28); color: #fca5a5; }
.srb-icon { font-size: 1rem; flex-shrink: 0; }
.srb-text { flex: 1; line-height: var(--leading-snug); }
.srb-goto {
  flex-shrink: 0; padding: 5px 11px; border-radius: var(--r-sm);
  background: var(--col-accent); color: #fff;
  font-family: var(--font-mono); font-size: var(--text-2xs); font-weight: 600; white-space: nowrap;
  transition: opacity var(--dur-fast), transform var(--dur-fast);
}
.srb-goto:hover { opacity: .86; transform: translateY(-1px); }


/* ─────────────────────── 09  STATS ROW ──────────────────────────── */
.stats { display: flex; align-items: center; gap: var(--sp-4); flex-wrap: wrap; }
.stat  { text-align: center; }
.stat-n {
  font-family: var(--font-mono);
  font-size: 1.32rem; font-weight: 600;
  color: var(--col-accent-l);
  line-height: 1; letter-spacing: -.4px;
  transition: color var(--dur-base);
}
.stat-l { font-size: var(--text-2xs); font-weight: 500; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .7px; margin-top: 4px; }

.refresh-btn {
  padding: 7px 14px; border-radius: var(--r-sm);
  background: var(--col-accent); color: #fff;
  font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500; white-space: nowrap;
  transition: background var(--dur-fast), transform var(--dur-fast), box-shadow var(--dur-fast);
}
.refresh-btn:hover  { background: var(--col-accent-l); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(37,99,235,.40); }
.refresh-btn:active { transform: translateY(0); box-shadow: none; }


/* ─────────────────────── 10  FEATURE TOOLBAR ────────────────────── */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-2);
  padding: 9px var(--sp-6);
  background: var(--col-surface-3);
  border-bottom: 1px solid var(--col-border);
}


/* ─────────────────────── 11  OCCUPANCY BAR ──────────────────────── */
.occ-bar-outer { flex: 1; min-width: 170px; max-width: 360px; }
.occ-bar-label {
  font-family: var(--font-mono); font-size: var(--text-2xs);
  color: var(--text-secondary); margin-bottom: 6px;
  letter-spacing: .3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.occ-bar-track { height: 5px; background: rgba(255,255,255,.07); border-radius: var(--r-full); overflow: hidden; }
.occ-bar-fill {
  height: 100%; width: 0%; border-radius: var(--r-full);
  background: linear-gradient(90deg, var(--col-green) 0%, var(--col-amber) 55%, var(--col-red) 100%);
  transition: width .7s var(--ease-in-out);
}


/* ─────────────────────── 12  TOOL BUTTONS ───────────────────────── */
.tool-btns { display: flex; gap: var(--sp-1); flex-wrap: wrap; align-items: center; }

.tool-btn {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 6px 13px; border-radius: var(--r-sm);
  background: rgba(255,255,255,.045);
  border: 1.5px solid rgba(255,255,255,.09);
  color: rgba(255,255,255,.70);
  font-family: var(--font-mono); font-size: var(--text-2xs); font-weight: 500; white-space: nowrap;
  transition:
    background var(--dur-fast), border-color var(--dur-fast),
    color var(--dur-fast), transform var(--dur-fast), box-shadow var(--dur-fast);
}
.tool-btn:hover  { background: rgba(37,99,235,.18); border-color: rgba(37,99,235,.50); color: var(--col-accent-xl); transform: translateY(-1px); box-shadow: 0 3px 12px rgba(37,99,235,.22); }
.tool-btn:active { transform: translateY(0); box-shadow: none; }
.tool-btn.active { background: var(--col-accent); border-color: var(--col-accent); color: #fff; box-shadow: var(--shadow-glow-blue); }
.tool-btn.danger { border-color: rgba(239,68,68,.28); color: #fca5a5; }
.tool-btn.danger:hover { background: rgba(239,68,68,.18); border-color: var(--col-red); color: #fff; box-shadow: 0 3px 12px rgba(239,68,68,.22); }


/* ─────────────────────── 13  FLOOR NAV BAR ──────────────────────── */
.floor-nav {
  display: flex; align-items: center; gap: var(--sp-2);
  padding: 9px var(--sp-6);
  background: var(--col-surface-1);
  border-bottom: 1px solid var(--col-border);
  position: sticky; top: 56px;
  z-index: calc(var(--z-nav) - 20);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}
.floor-nav-label {
  font-family: var(--font-mono); font-size: var(--text-2xs); font-weight: 500;
  color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .9px;
  flex-shrink: 0; margin-right: var(--sp-1);
}
.floor-btn {
  padding: 5px 18px; border-radius: var(--r-sm);
  background: rgba(255,255,255,.038);
  border: 1.5px solid rgba(255,255,255,.08);
  color: rgba(255,255,255,.50);
  font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; letter-spacing: .4px; white-space: nowrap;
  transition:
    background var(--dur-fast), border-color var(--dur-fast),
    color var(--dur-fast), transform var(--dur-fast), box-shadow var(--dur-fast);
}
.floor-btn:hover  { background: rgba(37,99,235,.18); border-color: rgba(37,99,235,.46); color: var(--col-accent-xl); transform: translateY(-1px); box-shadow: 0 3px 10px rgba(37,99,235,.22); }
.floor-btn:active { transform: translateY(0); }
.floor-btn.active { background: var(--col-accent); border-color: var(--col-accent); color: #fff; box-shadow: var(--shadow-glow-blue); }
.floor-nav-sep    { width: 1px; height: 20px; background: var(--col-border-light); flex-shrink: 0; margin: 0 var(--sp-1); }


/* ─────────────────────── 14  BUILDING SHELL ─────────────────────── */
.fp-scroll-hint {
  display: none;
  padding: 7px var(--sp-4); text-align: center;
  font-family: var(--font-mono); font-size: var(--text-xs);
  color: rgba(255,255,255,.24); letter-spacing: .5px;
  background: rgba(255,255,255,.018);
  border-bottom: 1px solid var(--col-border);
}

.fp-wrapper {
  display: flex; align-items: flex-start; justify-content: center;
  padding: 24px 18px 44px;
  overflow-x: auto; min-height: calc(100vh - 228px);
  -webkit-overflow-scrolling: touch;
}

.building {
  position: relative; width: 100%;
  max-width: 1160px; min-width: 640px;
  padding: 18px; border-radius: var(--r-xl);
  background: var(--col-surface-1);
  border: 1px solid var(--col-border);
  box-shadow:
    0 0 0 1px rgba(255,255,255,.04),
    var(--shadow-lg),
    0 0 80px rgba(37,99,235,.07);
}
.building::before {
  content: ''; position: absolute; inset: 0; border-radius: var(--r-xl);
  background: linear-gradient(140deg, rgba(37,99,235,.04) 0%, transparent 42%);
  pointer-events: none; z-index: 0;
}
.building > * { position: relative; z-index: 1; }

.building-label {
  font-family: var(--font-mono); font-size: var(--text-2xs);
  color: rgba(255,255,255,.18); text-transform: uppercase; letter-spacing: 2.8px;
  margin-bottom: 15px;
  display: flex; align-items: center; gap: 10px;
}
.building-label::before {
  content: ''; display: inline-block; width: 22px; height: 1px;
  background: rgba(255,255,255,.16); flex-shrink: 0;
}


/* ─────────────────────── 15  FLOOR-PLAN GRID ────────────────────── */
.fp {
  display: grid;
  grid-template-columns: 42px 1fr 1fr 36px 1fr 1fr 1fr 1fr 1fr 10px 1fr;
  grid-template-rows: auto 14px auto auto auto 14px auto;
  gap: 0;
  background: var(--fp-corridor);
  border-radius: var(--r-md);
  overflow: hidden;
  box-shadow: inset 0 0 0 1px rgba(0,0,0,.09);
}


/* ─────────────────────── 16  ROOM CARDS ─────────────────────────── */
.room {
  position: relative; display: flex; flex-direction: column;
  margin: 3px; padding: 8px 7px 8px 8px; min-height: 74px;
  border-radius: var(--r-sm);
  background: var(--fp-room-static); border: 1.5px solid var(--fp-room-stat-bdr);
  font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-tertiary);
  overflow: hidden;
  transition:
    background var(--dur-base), border-color var(--dur-base),
    box-shadow var(--dur-base), transform var(--dur-base), opacity var(--dur-base);
}
/* Door notch */
.room::after {
  content: ''; position: absolute; bottom: -1px; left: 50%; transform: translateX(-50%);
  width: 16px; height: 3px; background: var(--fp-corridor); border-radius: 2px 2px 0 0;
}
.room-num {
  font-size: var(--text-base); font-weight: 700; color: #384060;
  line-height: 1; margin-bottom: 2px; letter-spacing: -.3px; transition: color var(--dur-base);
}
.room-name-label { font-size: var(--text-2xs); color: #607090; line-height: var(--leading-snug); margin-bottom: 3px; word-break: break-word; }

.db-room { cursor: pointer; }

.east-wing-col { display: flex; flex-direction: column; margin: 3px; gap: 3px; }
.east-wing-col .room       { margin: 0; flex: 1; min-height: 0; }
.east-wing-col .stair-block { margin: 0; min-height: 40px; flex-shrink: 0; }
.east-wing-col .room.open-area-room { background: #ccd4e2; border-style: dashed; flex: 0.7; }


/* ─────────────────────── 17  ROOM STATES ────────────────────────── */
.db-room.empty-state    { background: var(--fp-room-empty); border-color: var(--fp-room-border); opacity: .60; }
.db-room.occupied-state {
  background: var(--fp-room-occ); border-color: var(--fp-room-occ-bdr); opacity: 1;
  box-shadow: 0 0 0 3px var(--fp-room-occ-glow), 0 4px 16px rgba(37,99,235,.18);
}
.db-room.occupied-state .room-num { color: var(--col-accent); }
.db-room:hover {
  opacity: 1 !important;
  transform: scale(1.048);
  z-index: var(--z-raised);
  box-shadow: 0 8px 28px rgba(0,0,0,.32), 0 2px 6px rgba(0,0,0,.20) !important;
}
.room-highlight {
  animation: roomPulse 1.1s ease-out infinite;
  border-color: var(--col-accent) !important;
  outline: 2.5px solid var(--col-accent);
  z-index: var(--z-raised);
}


/* ─────────────────────── 18  PATHFINDING ────────────────────────── */
.pf-source { outline: 2.5px solid var(--col-accent) !important; border-color: var(--col-accent) !important; box-shadow: 0 0 0 4px rgba(37,99,235,.22) !important; }
.pf-dest   { outline: 2.5px solid var(--col-green) !important;  border-color: var(--col-green) !important;  box-shadow: 0 0 0 4px rgba(16,185,129,.22) !important; }
.pf-path   { outline: 2px dashed var(--col-amber) !important; border-color: var(--col-amber) !important; animation: pathPulse 1.2s ease-in-out infinite; }


/* ─────────────────────── 19  HEATMAP ────────────────────────────── */
.hm-cold { background: rgba(148,163,184,.28) !important; }
.hm-cool { background: rgba(16,185,129,.18)  !important; }
.hm-warm { background: rgba(245,158,11,.20)  !important; }
.hm-hot  { background: rgba(239,68,68,.20)   !important; }


/* ─────────────────────── 20  STALE / OVER-CAP ───────────────────── */
.stale-room            { border-color: var(--col-amber) !important; opacity: .72 !important; }
.stale-room .room-num  { color: var(--col-amber) !important; }
.over-capacity         { border-color: var(--col-red) !important; }
.over-capacity .room-num { color: var(--col-red) !important; }


/* ─────────────────────── 21  ROOM BADGES ────────────────────────── */
.count-badge {
  position: absolute; top: 5px; right: 5px;
  padding: 1px 7px; border-radius: var(--r-full);
  background: var(--col-accent); color: #fff;
  font-family: var(--font-mono); font-size: var(--text-2xs); font-weight: 700; line-height: 1.5;
  box-shadow: 0 2px 7px rgba(37,99,235,.42);
}
.stale-badge {
  position: absolute; top: 5px; right: 5px;
  padding: 1px 6px; border-radius: var(--r-xs);
  background: var(--col-amber-dim); border: 1px solid var(--col-amber-border);
  font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--col-amber); line-height: 1.5;
}
.cap-badge {
  position: absolute; bottom: 5px; right: 5px;
  padding: 1px 6px; border-radius: var(--r-xs);
  background: var(--col-red-dim); border: 1px solid var(--col-red-border);
  font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--col-red); line-height: 1.5;
}


/* ─────────────────────── 22  RESERVATION TAGS ───────────────────── */
.res-tag {
  position: absolute; top: 0; left: 0; right: 0; z-index: var(--z-raised);
  padding: 2px 6px; font-family: var(--font-mono); font-size: var(--text-2xs); font-weight: 700;
  text-align: center; border-radius: var(--r-sm) var(--r-sm) 0 0; letter-spacing: .3px;
}
.res-exam   { background: rgba(185,28,28,.92);  color: #fecaca; border-bottom: 1px solid rgba(252,165,165,.28); }
.res-clean  { background: rgba(21,128,61,.92);  color: #bbf7d0; border-bottom: 1px solid rgba(134,239,172,.28); }
.res-reserv { background: rgba(161,98,7,.92);   color: #fde68a; border-bottom: 1px solid rgba(253,230,138,.28); }
.res-closed { background: rgba(71,85,105,.92);  color: #cbd5e1; border-bottom: 1px solid rgba(203,213,225,.28); }


/* ─────────────────────── 23  USER CHIPS ─────────────────────────── */
.user-chips { display: flex; flex-direction: column; gap: 2px; margin-top: 3px; overflow: hidden; flex: 1; }
.chip {
  padding: 2px 6px; border-radius: var(--r-xs);
  background: rgba(37,99,235,.09); border: 1px solid rgba(37,99,235,.14);
  font-size: var(--text-2xs); font-weight: 600; color: var(--col-accent-l);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.more-text { font-size: var(--text-2xs); color: var(--text-secondary); padding-left: 2px; }


/* ─────────────────────── 24  SPARKLINES ─────────────────────────── */
.sparkline-wrap { margin-top: auto; padding-top: 4px; line-height: 0; }


/* ─────────────────────── 25  STRUCTURAL ELEMENTS ────────────────── */

/* Stair blocks */
.stair-block {
  position: relative; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 3px;
  margin: 3px; border-radius: var(--r-sm);
  background: var(--fp-stair-bg);
  font-family: var(--font-mono); font-size: var(--text-2xs);
  color: var(--fp-stair-text); text-transform: uppercase; letter-spacing: .8px; overflow: hidden;
}
.stair-block::before {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(45deg,transparent,transparent 5px,rgba(0,0,0,.06) 5px,rgba(0,0,0,.06) 6px);
}
.stair-ico { font-size: 1.05rem; opacity: .50; position: relative; z-index: 1; }
.stair-lbl { position: relative; z-index: 1; text-align: center; line-height: var(--leading-snug); }

/* Shaft columns */
.shaft-col {
  position: relative; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  margin: 3px; border-radius: var(--r-sm);
  background: var(--fp-shaft-bg); overflow: hidden;
}
.shaft-col::before {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(90deg,transparent,transparent 3px,rgba(255,255,255,.10) 3px,rgba(255,255,255,.10) 4px);
}

/* Horizontal corridors */
.corr-h {
  position: relative; display: flex; align-items: center; justify-content: center;
  background: var(--fp-corridor); overflow: hidden;
}
.corr-h::before {
  content: attr(data-label);
  font-family: var(--font-mono); font-size: var(--text-2xs);
  color: rgba(70,90,110,.65); text-transform: uppercase; letter-spacing: 2.5px;
  position: relative; z-index: 1;
}
.corr-h::after {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(90deg,transparent,transparent 26px,rgba(0,0,0,.03) 26px,rgba(0,0,0,.03) 27px);
}

/* Service zones */
.service-zone { display: flex; flex-direction: row; margin: 3px; border-radius: var(--r-sm); overflow: hidden; background: var(--fp-service-bg); }

.sz-stair {
  position: relative; flex: 0 0 32px;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
  background: var(--fp-stair-bg);
  font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--fp-stair-text);
  text-transform: uppercase; letter-spacing: .7px; overflow: hidden;
}
.sz-stair::before {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(45deg,transparent,transparent 4px,rgba(0,0,0,.07) 4px,rgba(0,0,0,.07) 5px);
}
.sz-stair span    { font-size: .88rem; opacity: .50; position: relative; z-index: 1; }
.sz-stair-lbl     { position: relative; z-index: 1; text-align: center; line-height: var(--leading-snug); }

.sz-wc {
  flex: 0 0 28px; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 2px;
  background: #b8c2d4;
  font-family: var(--font-mono); font-size: var(--text-2xs); color: #566080;
  text-transform: uppercase; letter-spacing: .6px;
  border-left: 1px solid rgba(0,0,0,.08);
}
.sz-wc span { font-size: .84rem; }

.sz-open {
  position: relative; flex: 1;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: #ccd4e4;
  font-family: var(--font-mono); font-size: var(--text-2xs); color: #667090;
  text-transform: uppercase; letter-spacing: .7px; text-align: center;
  line-height: var(--leading-snug); border-left: 1px solid rgba(0,0,0,.07); overflow: hidden;
}
.sz-open::before {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(-45deg,transparent,transparent 6px,rgba(0,0,0,.024) 6px,rgba(0,0,0,.024) 7px);
}
.sz-open span { position: relative; z-index: 1; }

/* Storage zone */
.storage-zone {
  position: relative; display: flex; align-items: center; justify-content: center;
  margin: 3px; border-radius: var(--r-sm);
  background: var(--fp-storage-bg); border: 1.5px dashed #96a0b6;
  font-family: var(--font-mono); font-size: var(--text-2xs); color: #687090;
  text-transform: uppercase; letter-spacing: 1px; text-align: center;
  line-height: var(--leading-normal); min-height: 44px; overflow: hidden;
}
.storage-zone::before {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(45deg,transparent,transparent 8px,rgba(0,0,0,.024) 8px,rgba(0,0,0,.024) 9px);
}
.storage-zone span { position: relative; z-index: 1; }

/* Mini shaft */
.mini-shaft {
  position: relative; display: flex; align-items: center; justify-content: center;
  margin: 3px; border-radius: 5px; background: var(--fp-mini-shaft);
  min-height: 22px; font-family: var(--font-mono); font-size: var(--text-2xs);
  letter-spacing: .5px; text-transform: uppercase; overflow: hidden;
}
.mini-shaft::before {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(90deg,transparent,transparent 3px,rgba(255,255,255,.08) 3px,rgba(255,255,255,.08) 4px);
}
.mini-shaft span { position: relative; z-index: 1; color: #58667e; font-size: var(--text-2xs); }


/* ─────────────────────── 26  LIFT SHAFT ─────────────────────────── */
.lift-shaft { cursor: pointer; transition: filter var(--dur-fast), box-shadow var(--dur-fast); }
.lift-shaft:hover { filter: brightness(1.24) saturate(1.12); box-shadow: inset 0 0 0 2.5px rgba(37,99,235,.70); }
.lift-shaft-icon {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  font-size: 1.30rem; opacity: 0; pointer-events: none; z-index: var(--z-raised);
  transition: opacity var(--dur-base) var(--ease-out-expo);
  filter: drop-shadow(0 2px 6px rgba(37,99,235,.65));
}
.lift-shaft:hover .lift-shaft-icon { opacity: 1; }


/* ─────────────────────── 27  LEGEND ─────────────────────────────── */
.legend { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 14px; padding: 0 2px; }
.leg    { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: var(--text-2xs); color: rgba(255,255,255,.28); letter-spacing: .4px; }
.leg-box       { width: 12px; height: 12px; border-radius: var(--r-xs); }
.leg-box.occ   { background: #fff; border: 2px solid var(--col-accent); }
.leg-box.emp   { background: var(--fp-room-empty); border: 1.5px solid var(--fp-room-border); opacity: .68; }
.leg-box.stat  { background: var(--fp-room-static); border: 1.5px solid var(--fp-room-stat-bdr); }


/* ─────────────────────── 28  ROOM DETAIL MODAL ──────────────────── */
.overlay {
  position: fixed; inset: 0; z-index: var(--z-overlay);
  display: none; align-items: center; justify-content: center;
  padding: var(--sp-5);
  background: rgba(4,9,20,.76);
  backdrop-filter: blur(12px) saturate(160%);
  -webkit-backdrop-filter: blur(12px) saturate(160%);
}
.overlay.open { display: flex; }

.modal {
  position: relative; width: 100%; max-width: 390px;
  padding: 26px; border-radius: var(--r-2xl);
  background: var(--col-surface-3);
  border: 1px solid var(--col-border-light);
  box-shadow: var(--shadow-xl), 0 0 0 1px rgba(37,99,235,.08);
  animation: modalEnter var(--dur-enter) var(--ease-spring);
  background-image: linear-gradient(145deg,rgba(255,255,255,.04) 0%,transparent 48%);
}
.modal-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.m-room { font-family: var(--font-mono); font-size: var(--text-3xl); font-weight: 600; color: var(--col-accent-l); line-height: 1; letter-spacing: -1px; }
.m-sub  { font-size: var(--text-xs); color: var(--text-secondary); margin-top: 5px; }
.m-close {
  display: flex; align-items: center; justify-content: center;
  width: 30px; height: 30px; border-radius: 50%;
  background: rgba(255,255,255,.052); border: 1px solid var(--col-border-light);
  color: var(--text-secondary); font-size: .80rem; flex-shrink: 0;
  transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
}
.m-close:hover { background: var(--col-red-dim); border-color: var(--col-red-border); color: #fca5a5; }
.m-hr   { border: none; border-top: 1px solid rgba(255,255,255,.07); margin-bottom: 16px; }
.m-list { display: flex; flex-direction: column; gap: 10px; }
.m-row  { display: flex; align-items: center; gap: 12px; }
.m-av   {
  width: 40px; height: 40px; border-radius: var(--r-md); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg,var(--col-accent),var(--col-accent2));
  font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; color: #fff;
  box-shadow: 0 4px 14px rgba(37,99,235,.36); transition: transform var(--dur-fast);
}
.m-row:hover .m-av { transform: scale(1.06); }
.m-name    { font-weight: 700; font-size: var(--text-base); color: var(--text-primary); }
.m-time    { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary); margin-top: 2px; }
.m-empty   { text-align: center; padding: 24px 0; color: var(--text-secondary); font-size: var(--text-base); }
.m-empty-ico { font-size: 2.2rem; display: block; margin-bottom: 8px; }


/* ─────────────────────── 29  24H TIMELINE MODAL ─────────────────── */
.tl-overlay {
  position: fixed; inset: 0; z-index: var(--z-modal);
  display: none; align-items: center; justify-content: center;
  padding: var(--sp-5);
  background: rgba(4,9,20,.76);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
}
.tl-overlay.open { display: flex; }

.tl-modal {
  position: relative; width: 100%; max-width: 450px; max-height: 80vh;
  display: flex; flex-direction: column;
  padding: 24px; border-radius: var(--r-2xl);
  background: var(--col-surface-3); border: 1px solid var(--col-border-light);
  box-shadow: var(--shadow-xl);
  animation: modalEnter var(--dur-enter) var(--ease-spring);
}
.tl-head  { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.tl-title { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 700; color: var(--col-accent-l); line-height: var(--leading-tight); }
.tl-sub   { font-size: var(--text-xs); color: var(--text-secondary); margin-top: 3px; }
.tl-close {
  display: flex; align-items: center; justify-content: center;
  width: 28px; height: 28px; border-radius: 50%;
  background: rgba(255,255,255,.05); border: 1px solid var(--col-border-light);
  color: var(--text-secondary); font-size: .78rem; flex-shrink: 0;
  transition: background var(--dur-fast), color var(--dur-fast);
}
.tl-close:hover { background: var(--col-red-dim); color: #fca5a5; }
.tl-body  { flex: 1; overflow-y: auto; padding-right: 2px; }
.tl-entry {
  display: flex; align-items: flex-start; gap: 12px; padding: 10px 0;
  border-bottom: 1px solid rgba(255,255,255,.04); position: relative;
}
.tl-entry:last-child { border-bottom: none; }
.tl-dot {
  width: 10px; height: 10px; border-radius: 50%; background: var(--col-accent);
  margin-top: 5px; flex-shrink: 0; position: relative; z-index: 1;
  box-shadow: 0 0 8px rgba(37,99,235,.55);
}
.tl-line  { position: absolute; left: 4px; top: 15px; bottom: -10px; width: 2px; background: rgba(255,255,255,.06); }
.tl-entry:last-child .tl-line { display: none; }
.tl-info  { flex: 1; }
.tl-name  { font-weight: 700; font-size: var(--text-base); color: var(--text-primary); }
.tl-time  { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary); margin-top: 2px; }
.tl-empty,
.tl-loading { text-align: center; padding: 36px 0; color: var(--text-secondary); font-size: var(--text-sm); font-family: var(--font-mono); }


/* ─────────────────────── 30  EMERGENCY ROLL-CALL ────────────────── */
.em-overlay { position: fixed; inset: 0; z-index: var(--z-em); display: none; flex-direction: column; background: rgba(4,8,18,.97); }
.em-overlay.open { display: flex; }

.em-header {
  flex-shrink: 0; display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 12px; padding: 16px var(--sp-6);
  background: linear-gradient(90deg,#7f1d1d,#991b1b);
  border-bottom: 1px solid rgba(255,255,255,.10);
  box-shadow: 0 4px 20px rgba(0,0,0,.40);
}
.em-title     { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 700; color: #fff; display: flex; align-items: center; gap: var(--sp-2); }
.em-hdr-btns  { display: flex; gap: var(--sp-2); flex-shrink: 0; }
.em-btn {
  padding: 7px 15px; border-radius: var(--r-sm);
  background: rgba(255,255,255,.11); border: 1px solid rgba(255,255,255,.19);
  color: #fff; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500; white-space: nowrap;
  transition: background var(--dur-fast), transform var(--dur-fast);
}
.em-btn:hover { background: rgba(255,255,255,.22); transform: translateY(-1px); }

.em-body {
  flex: 1; overflow-y: auto; padding: 22px var(--sp-6);
  display: grid; grid-template-columns: repeat(auto-fill,minmax(215px,1fr));
  gap: 14px; align-content: start;
}
.em-card {
  padding: 14px; border-radius: var(--r-lg);
  background: rgba(255,255,255,.034); border: 1px solid rgba(255,255,255,.08);
  transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
}
.em-card:hover { border-color: rgba(239,68,68,.28); box-shadow: 0 4px 16px rgba(0,0,0,.26); }
.em-room-n { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 700; color: #fff; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,.07); }
.em-person { display: flex; align-items: center; gap: 9px; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,.04); }
.em-person:last-child { border-bottom: none; }
.em-av {
  width: 30px; height: 30px; border-radius: var(--r-sm); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg,var(--col-accent),var(--col-accent2));
  font-family: var(--font-mono); font-size: var(--text-2xs); font-weight: 700; color: #fff;
}
.em-uid   { font-size: var(--text-sm); color: rgba(255,255,255,.88); font-weight: 600; }
.em-ts    { font-family: var(--font-mono); font-size: var(--text-2xs); color: rgba(255,255,255,.30); }
.em-footer {
  flex-shrink: 0; padding: 13px var(--sp-6);
  background: rgba(0,0,0,.50); border-top: 1px solid rgba(255,255,255,.06);
  font-family: var(--font-mono); font-size: var(--text-xs); color: rgba(255,255,255,.32);
}


/* ─────────────────────── 31  PATHFINDING BANNER ─────────────────── */
.pf-banner {
  display: none; position: fixed; bottom: 26px; left: 50%; transform: translateX(-50%);
  z-index: var(--z-banner); align-items: center; gap: 14px; padding: 13px 22px;
  border-radius: var(--r-xl);
  background: rgba(15,28,50,.92); border: 1px solid var(--col-border-light);
  color: var(--text-primary); font-family: var(--font-mono); font-size: var(--text-sm);
  white-space: nowrap; max-width: calc(100vw - 32px);
  box-shadow: var(--shadow-xl);
  backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
}
.pf-banner.visible { display: flex; animation: slideUp var(--dur-enter) var(--ease-out-expo); }
.pf-status  { color: var(--col-accent2); overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.pf-cancel  {
  flex-shrink: 0; padding: 5px 12px; border-radius: var(--r-sm);
  background: rgba(255,255,255,.07); border: 1px solid var(--col-border-light);
  color: var(--text-primary); font-family: var(--font-mono); font-size: var(--text-xs);
  transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
}
.pf-cancel:hover { background: var(--col-red-dim); border-color: var(--col-red-border); color: #fca5a5; }


/* ─────────────────────── 32  LIFT POPUP ─────────────────────────── */
.lift-overlay {
  position: fixed; inset: 0; z-index: var(--z-lift);
  display: none; align-items: center; justify-content: center; padding: var(--sp-5);
  background: rgba(4,9,20,.84);
  backdrop-filter: blur(16px) saturate(180%); -webkit-backdrop-filter: blur(16px) saturate(180%);
}
.lift-overlay.open { display: flex; }

.lift-modal {
  position: relative; width: 100%; max-width: 368px;
  padding: 28px 26px 22px; border-radius: var(--r-2xl);
  background: var(--col-surface-3); border: 1px solid var(--col-border-light);
  box-shadow: var(--shadow-xl), 0 0 0 1px rgba(37,99,235,.09);
  animation: modalEnter var(--dur-enter) var(--ease-spring);
  background-image: linear-gradient(145deg,rgba(255,255,255,.038) 0%,transparent 44%);
}
.lift-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 4px; }
.lift-title { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 9px; }
.lift-subtitle { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary); margin-bottom: 22px; }
.lift-close {
  display: flex; align-items: center; justify-content: center;
  width: 30px; height: 30px; border-radius: 50%;
  background: rgba(255,255,255,.052); border: 1px solid var(--col-border-light);
  color: var(--text-secondary); font-size: .80rem; flex-shrink: 0;
  transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
}
.lift-close:hover { background: var(--col-red-dim); border-color: var(--col-red-border); color: #fca5a5; }

.lift-floors { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; }
.lift-floor-btn {
  position: relative; display: flex; flex-direction: column; align-items: center; gap: 5px;
  padding: 16px 8px; border-radius: var(--r-md);
  background: rgba(255,255,255,.044); border: 1.5px solid rgba(255,255,255,.09);
  color: rgba(255,255,255,.70); font-family: var(--font-mono); font-size: var(--text-xl); font-weight: 700; overflow: hidden;
  transition:
    background var(--dur-base) var(--ease-out-expo), border-color var(--dur-base),
    color var(--dur-base), transform var(--dur-base) var(--ease-spring), box-shadow var(--dur-base);
}
.lift-floor-btn .lf-label { font-size: var(--text-2xs); font-weight: 400; color: var(--text-secondary); letter-spacing: .7px; text-transform: uppercase; line-height: 1; }
.lift-floor-btn:hover  { background: rgba(37,99,235,.18); border-color: rgba(37,99,235,.50); color: #fff; transform: translateY(-3px); box-shadow: 0 8px 22px rgba(37,99,235,.30); }
.lift-floor-btn:active { transform: translateY(-1px); }
.lift-floor-btn.lf-current { background: var(--col-accent); border-color: var(--col-accent); color: #fff; box-shadow: 0 0 26px rgba(37,99,235,.62); }
.lift-floor-btn.lf-current .lf-label { color: rgba(255,255,255,.60); }
.lift-floor-btn.lf-current::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg,rgba(255,255,255,.12) 0%,transparent 54%);
}
.lift-you-are { margin-top: 16px; text-align: center; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-tertiary); }


/* ─────────────────────── 33  CONTEXT MENU ───────────────────────── */
.ctx-menu {
  position: fixed; z-index: var(--z-ctx);
  display: none; padding: 5px 0; min-width: 196px; border-radius: var(--r-lg);
  background: var(--col-surface-1); border: 1.5px solid var(--col-border-light);
  box-shadow: var(--shadow-xl);
  animation: dropIn .12s var(--ease-out-expo);
}
.ctx-menu.open { display: block; }
.ctx-lbl  { padding: 5px 14px 6px; font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 1.2px; font-weight: 500; }
.ctx-sep  { height: 1px; background: var(--col-border); margin: 4px 0; }
.ctx-item { display: flex; align-items: center; gap: 9px; padding: 9px 14px; font-size: var(--text-sm); color: rgba(255,255,255,.74); cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast); }
.ctx-item:hover            { background: rgba(37,99,235,.14); color: var(--text-primary); }
.ctx-item.ctx-danger:hover { background: var(--col-red-dim); color: #fca5a5; }


/* ─────────────────────── 34  SCROLLBAR ──────────────────────────── */
::-webkit-scrollbar            { width: 5px; height: 5px; }
::-webkit-scrollbar-track      { background: rgba(255,255,255,.028); }
::-webkit-scrollbar-thumb      { background: rgba(255,255,255,.12); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover{ background: rgba(255,255,255,.22); }


/* ─────────────────────── 35  FOCUS / A11Y ───────────────────────── */
:focus-visible        { outline: 2px solid var(--col-accent); outline-offset: 2px; border-radius: var(--r-xs); }
button:focus-visible  { box-shadow: 0 0 0 3px rgba(37,99,235,.38); }
.search-input:focus   { outline: none; }


/* ─────────────────────── 36  KEYFRAMES ──────────────────────────── */
@keyframes livePulse {
  0%,100% { opacity: 1; transform: scale(1); }
  50%     { opacity: .18; transform: scale(.82); }
}
@keyframes modalEnter {
  from { opacity: 0; transform: scale(.86) translateY(16px); }
  to   { opacity: 1; transform: scale(1)   translateY(0); }
}
@keyframes dropIn {
  from { opacity: 0; transform: translateY(-7px) scale(.96); }
  to   { opacity: 1; transform: translateY(0)    scale(1); }
}
@keyframes slideUp {
  from { opacity: 0; transform: translateX(-50%) translateY(16px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}
@keyframes pathPulse {
  0%,100% { opacity: 1; }
  50%     { opacity: .32; }
}
@keyframes roomPulse {
  0%   { box-shadow: 0 0 0 0   rgba(37,99,235,.88); }
  60%  { box-shadow: 0 0 0 12px rgba(37,99,235,0); }
  100% { box-shadow: 0 0 0 0   rgba(37,99,235,0); }
}
@keyframes shimmer {
  from { background-position: -600px 0; }
  to   { background-position:  600px 0; }
}
.shimmer {
  background: linear-gradient(90deg, rgba(255,255,255,.04) 25%, rgba(255,255,255,.09) 50%, rgba(255,255,255,.04) 75%);
  background-size: 600px 100%;
  animation: shimmer 1.6s infinite;
}


/* ─────────────────────── 37  UTILITIES ──────────────────────────── */
.sr-only  { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0; }
.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }


/* ─────────────────────── 38  RESPONSIVE ─────────────────────────── */

/* ≥ 1440px */
@media (min-width: 1440px) {
  .navbar, .topbar, .toolbar, .floor-nav { padding-left: 40px; padding-right: 40px; }
  .fp-wrapper { padding: 32px 30px 52px; }
  .building   { padding: 22px; }
  .stat-n     { font-size: 1.50rem; }
}

/* 1280–1439px */
@media (min-width: 1280px) and (max-width: 1439px) {
  .navbar, .topbar, .toolbar, .floor-nav { padding-left: 32px; padding-right: 32px; }
  .fp-wrapper { padding: 26px 24px 44px; }
}

/* 1024–1279px */
@media (max-width: 1279px) and (min-width: 1024px) {
  .building        { max-width: 980px; }
  .search-bar-wrap { max-width: 250px; }
}

/* 768–1023px */
@media (max-width: 1023px) and (min-width: 768px) {
  .navbar { padding: 0 18px; }
  .topbar { padding: 10px 18px; flex-direction: column; align-items: stretch; gap: 10px; }
  .building-info  { display: flex; align-items: baseline; justify-content: space-between; }
  .search-bar-wrap{ max-width: 100%; min-width: 0; }
  .stats          { justify-content: space-between; width: 100%; }
  .toolbar        { padding: 8px 18px; flex-direction: column; align-items: stretch; gap: 8px; }
  .occ-bar-outer  { max-width: 100%; }
  .tool-btns      { justify-content: flex-start; }
  .floor-nav      { padding: 8px 18px; flex-wrap: wrap; }
  .fp-wrapper     { padding: 16px 12px 32px; }
  .building       { max-width: 100%; min-width: 620px; }
  .fp-scroll-hint { display: block; }
}

/* < 768px */
@media (max-width: 767px) {
  .navbar  { padding: 0 14px; height: 50px; }
  .logo    { font-size: .90rem; }
  .live-pill { padding: 4px 10px; font-size: .58rem; }
  .live-pill span { display: none; }
  .nav-btn { padding: 5px 11px; font-size: .70rem; }
  .floor-nav { top: 50px; padding: 8px 14px; flex-wrap: wrap; gap: 6px; }
  .floor-btn { padding: 5px 13px; font-size: var(--text-2xs); }
  .topbar  { padding: 10px 14px; flex-direction: column; align-items: stretch; gap: 10px; }
  .building-info h2 { font-size: .84rem; }
  .search-bar-wrap  { max-width: 100%; min-width: 0; flex: none; }
  .stats {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto;
    align-items: center; gap: 0; width: 100%;
  }
  .stat-n  { font-size: 1.10rem; }
  .refresh-btn { display: none; }
  .toolbar { padding: 8px 14px; flex-direction: column; align-items: stretch; gap: 8px; }
  .occ-bar-outer { max-width: 100%; }
  .tool-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .tool-btn  { justify-content: center; padding: 9px 10px; font-size: var(--text-2xs); }
  .fp-scroll-hint { display: block; }
  .fp-wrapper { padding: 12px 0 28px; justify-content: flex-start; }
  .building   { border-radius: 0; min-width: 600px; padding: 12px; box-shadow: none; }
  .overlay, .tl-overlay { padding: 12px; align-items: flex-end; }
  .modal    { border-radius: 22px 22px 14px 14px; padding: 20px 18px; max-width: 100%; }
  .tl-modal { border-radius: 22px 22px 14px 14px; max-height: 88vh; padding: 20px 18px; max-width: 100%; }
  .em-body   { grid-template-columns: 1fr 1fr; padding: 14px; gap: 10px; }
  .em-header { padding: 12px 16px; }
  .em-title  { font-size: .84rem; }
  .em-footer { padding: 10px 16px; }
  .pf-banner { bottom: 14px; flex-wrap: wrap; gap: 8px; justify-content: center; text-align: center; padding: 12px 18px; }
  .ctx-menu  { min-width: 172px; }
  .lift-modal { padding: 22px 18px 18px; }
  .lift-floors { gap: 8px; }
  .lift-floor-btn { padding: 13px 6px; font-size: var(--text-lg); }
}

/* < 400px */
@media (max-width: 399px) {
  .em-body  { grid-template-columns: 1fr; }
  .stats    { grid-template-columns: 1fr 1fr 1fr; gap: var(--sp-2); }
  .sep      { display: none; }
  .building { min-width: 560px; }
  .floor-btn { padding: 5px 10px; }
}


/* ─────────────────────── 39  PRINT ──────────────────────────────── */
@media print {
  body > *:not(.em-overlay) { display: none !important; }
  .em-overlay { position: static !important; background: #fff !important; display: flex !important; }
  .em-header  { background: #dc2626 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .em-card    { background: #fff !important; border: 1px solid #ccc !important; break-inside: avoid; }
  .em-room-n, .em-uid { color: #000 !important; }
  .em-ts      { color: #555 !important; }
}
  </style>
</head>
