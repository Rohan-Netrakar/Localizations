<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Floor Map – IndoorLocate</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="/socket.io/socket.io.js"></script>
  <style>
    :root {
      --wall:          #1e2638;
      --corridor:      #b8c4d4;
      --floor-bg:      #dde4ee;
      --static-room:   #cfd6e8;
      --static-border: #a4aec4;
      --empty-room:    #e8ecf6;
      --empty-border:  #b4bcd4;
      --occ-room:      #ffffff;
      --occ-border:    #2563eb;
      --occ-glow:      rgba(37,99,235,0.15);
      --accent:        #2563eb;
      --accent2:       #06b6d4;
      --green:         #10b981;
      --red:           #ef4444;
      --text:          #1e2535;
      --muted:         #6b7a99;
      --stair-bg:      #a4afc4;
      --stair-text:    #4a5470;
      --service-bg:    #c8cfe0;
      --mono:          'IBM Plex Mono', monospace;
      --sans:          'Outfit', sans-serif;
    }
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

    body { font-family:var(--sans); background:#d4dbe8; color:var(--text); min-height:100vh; }

    /* ─── Navbar ─── */
    .navbar {
      background:var(--wall); height:54px;
      display:flex; align-items:center; justify-content:space-between;
      padding:0 28px; position:sticky; top:0; z-index:200;
      box-shadow:0 2px 12px rgba(0,0,0,0.3);
    }
    .logo { font-family:var(--mono); font-size:1rem; font-weight:600; color:#fff; letter-spacing:1px; }
    .logo span { color:var(--accent2); }
    .nav-right { display:flex; align-items:center; gap:12px; }
    .live-pill {
      display:flex; align-items:center; gap:6px;
      background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.3);
      border-radius:20px; padding:4px 12px;
      font-family:var(--mono); font-size:0.68rem; color:var(--green);
    }
    .live-dot { width:7px; height:7px; border-radius:50%; background:var(--green); animation:blink 1.8s infinite; }
    .live-dot.err { background:var(--red); animation:none; }
    @keyframes blink { 0%,100%{opacity:1}50%{opacity:0.3} }
    .nav-btn {
      background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15);
      color:#fff; padding:5px 14px; border-radius:6px;
      cursor:pointer; font-family:var(--sans); font-size:0.8rem; font-weight:500;
    }
    .nav-btn:hover { background:rgba(255,255,255,0.18); }

    /* ─── Topbar ─── */
    .topbar {
      background:#fff; border-bottom:1px solid #dde3ec;
      padding:10px 28px;
      display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;
    }
    .building-info h2 { font-size:0.95rem; font-weight:700; }
    .building-info p { font-family:var(--mono); font-size:0.65rem; color:var(--muted); margin-top:2px; }
    .stats { display:flex; align-items:center; gap:18px; }
    .stat { text-align:center; }
    .stat-n { font-family:var(--mono); font-size:1.35rem; font-weight:600; color:var(--accent); line-height:1; }
    .stat-l { font-size:0.62rem; color:var(--muted); text-transform:uppercase; letter-spacing:0.4px; margin-top:2px; }
    .sep { width:1px; height:28px; background:#e2e6ef; }
    .refresh-btn {
      background:var(--accent); border:none; color:#fff;
      padding:6px 14px; border-radius:6px; cursor:pointer;
      font-family:var(--mono); font-size:0.72rem; transition:opacity .2s;
    }
    .refresh-btn:hover { opacity:0.85; }

    /* ─── Wrapper ─── */
    .fp-wrapper {
      padding:24px 16px;
      overflow-x:auto;
      min-height:calc(100vh - 110px);
      display:flex; align-items:flex-start; justify-content:center;
    }

    /* ─── Building shell ─── */
    .building {
      background:var(--wall); border-radius:14px; padding:16px;
      width:100%; max-width:1120px;
      box-shadow:0 10px 50px rgba(0,0,0,0.3);
    }
    .building-label {
      font-family:var(--mono); font-size:0.58rem; color:rgba(255,255,255,0.28);
      text-transform:uppercase; letter-spacing:2px; margin-bottom:12px;
    }

    /* ═══════════════════════════════════════════════════
       FLOOR PLAN GRID
       11 columns:
         C1 42px  = NW/SW step column
         C2 1fr   = north/south outer-A rooms + west inner 306/301/337
         C3 1fr   = north/south outer-B rooms + stair shaft (middle rows)
         C4 36px  = inner staircase L shaft
         C5 1fr   = 307/302/334/332
         C6 1fr   = 310/309/331/330
         C7 1fr   = service-zone(R1,R7) / 311(R3) / storage(R4) / 329(R5)
         C8 1fr   = service-zone(R1,R7) / 313(R3+R4) / 328(R5)
         C9 1fr   = 314(R1) / 319(R3) / shaft(R4) / 321(R5) / 326(R7)
         C10 10px = east corridor
         C11 1fr  = east wing (spans all rows, flex inside)
       7 rows:
         R1 auto  = north face rooms
         R2 14px  = top corridor-H
         R3 auto  = upper middle rooms
         R4 auto  = shafts + under-floor storage
         R5 auto  = lower middle rooms
         R6 14px  = bottom corridor-H
         R7 auto  = south face rooms
    ═══════════════════════════════════════════════════ */
    .fp {
      display:grid;
      grid-template-columns: 42px 1fr 1fr 36px 1fr 1fr 1fr 1fr 1fr 10px 1fr;
      grid-template-rows: auto 14px auto auto auto 14px auto;
      gap:0;
      background:var(--corridor);
      border-radius:10px;
      overflow:hidden;
    }

    /* ─── Base room ─── */
    .room {
      background:var(--static-room);
      border:1.5px solid var(--static-border);
      margin:3px; border-radius:6px;
      padding:7px 6px;
      display:flex; flex-direction:column;
      min-height:72px; position:relative;
      font-size:0.65rem; color:var(--muted);
      font-family:var(--mono); overflow:hidden;
    }
    /* door notch */
    .room::after {
      content:''; position:absolute; bottom:-1px; left:50%;
      transform:translateX(-50%);
      width:16px; height:3px;
      background:var(--corridor); border-radius:2px 2px 0 0;
    }
    .room-num { font-size:0.88rem; font-weight:700; color:#3a4562; line-height:1; margin-bottom:2px; }
    .room-name-label { font-size:0.52rem; color:var(--muted); line-height:1.3; margin-bottom:3px; word-break:break-word; }

    /* ─── DB (live-tracked) rooms ─── */
    .db-room { cursor:pointer; transition:all 0.18s; }
    .db-room.empty-state {
      background:var(--empty-room);
      border-color:var(--empty-border);
      opacity:0.62;
    }
    .db-room.occupied-state {
      background:var(--occ-room);
      border-color:var(--occ-border);
      box-shadow:0 0 0 3px var(--occ-glow), 0 3px 14px rgba(37,99,235,0.12);
      opacity:1;
    }
    .db-room:hover { opacity:1 !important; transform:scale(1.035); z-index:10; box-shadow:0 6px 20px rgba(0,0,0,0.18); }
    .db-room.occupied-state .room-num { color:var(--accent); }

    .count-badge {
      position:absolute; top:5px; right:5px;
      background:var(--accent); color:#fff;
      border-radius:20px; padding:1px 6px;
      font-family:var(--mono); font-size:0.56rem; font-weight:600;
    }
    .user-chips { display:flex; flex-direction:column; gap:2px; margin-top:3px; overflow:hidden; flex:1; }
    .chip {
      background:rgba(37,99,235,0.1); border-radius:3px; padding:1px 5px;
      font-size:0.56rem; font-weight:600; color:var(--accent);
      white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    }
    .more-text { font-size:0.53rem; color:var(--muted); padding-left:1px; }

    /* ─── Staircase blocks ─── */
    .stair-block {
      background:var(--stair-bg);
      margin:3px; border-radius:6px;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      gap:2px; font-family:var(--mono); font-size:0.46rem;
      color:var(--stair-text); text-transform:uppercase; letter-spacing:0.8px;
      position:relative; overflow:hidden;
    }
    /* diagonal stair lines texture */
    .stair-block::before {
      content:''; position:absolute; inset:0;
      background:repeating-linear-gradient(
        45deg, transparent, transparent 5px,
        rgba(0,0,0,0.07) 5px, rgba(0,0,0,0.07) 6px
      );
    }
    .stair-ico { font-size:1.1rem; opacity:0.55; position:relative; z-index:1; }
    .stair-lbl { position:relative; z-index:1; text-align:center; line-height:1.4; }

    /* ─── Inner stair shaft (C4, spans middle rows) ─── */
    .shaft-col {
      background:#9aa5bc;
      margin:3px; border-radius:6px;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      gap:0; position:relative; overflow:hidden;
    }
    .shaft-col::before {
      content:''; position:absolute; inset:0;
      background:repeating-linear-gradient(
        90deg, transparent, transparent 3px,
        rgba(255,255,255,0.12) 3px, rgba(255,255,255,0.12) 4px
      );
    }

    /* ─── Horizontal corridors ─── */
    .corr-h {
      background:var(--corridor);
      display:flex; align-items:center; justify-content:center;
      position:relative; overflow:hidden;
    }
    .corr-h::before {
      content:attr(data-label);
      font-family:var(--mono); font-size:0.52rem;
      color:#7a8899; text-transform:uppercase; letter-spacing:2px;
      position:relative; z-index:1;
    }
    .corr-h::after {
      content:''; position:absolute; inset:0;
      background:repeating-linear-gradient(90deg, transparent, transparent 26px, rgba(0,0,0,0.04) 26px, rgba(0,0,0,0.04) 27px);
    }

    /* ─── Service zones (stair + WR + Open Area) ─── */
    .service-zone {
      margin:3px; border-radius:6px; overflow:hidden;
      display:flex; flex-direction:row; gap:0;
      background:var(--service-bg);
    }
    .sz-stair {
      background:var(--stair-bg); flex:0 0 32px;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      gap:2px; font-family:var(--mono); font-size:0.44rem;
      color:var(--stair-text); text-transform:uppercase; letter-spacing:0.7px;
      position:relative; overflow:hidden;
    }
    .sz-stair::before {
      content:''; position:absolute; inset:0;
      background:repeating-linear-gradient(45deg,transparent,transparent 4px,rgba(0,0,0,0.08) 4px,rgba(0,0,0,0.08) 5px);
    }
    .sz-stair span { font-size:0.9rem; opacity:0.55; position:relative; z-index:1; }
    .sz-stair-lbl { position:relative; z-index:1; text-align:center; }
    .sz-wc {
      flex:0 0 28px;
      background:#bcc5d8;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      gap:2px; font-family:var(--mono); font-size:0.44rem;
      color:#5a6480; text-transform:uppercase; letter-spacing:0.6px;
      border-left:1px solid rgba(0,0,0,0.1);
    }
    .sz-wc span { font-size:0.85rem; }
    .sz-open {
      flex:1;
      background:#d0d8e8;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      font-family:var(--mono); font-size:0.46rem;
      color:#6a7490; text-transform:uppercase; letter-spacing:0.7px;
      text-align:center; line-height:1.4;
      border-left:1px solid rgba(0,0,0,0.08);
      position:relative; overflow:hidden;
    }
    .sz-open::before {
      content:''; position:absolute; inset:0;
      background:repeating-linear-gradient(-45deg,transparent,transparent 6px,rgba(0,0,0,0.03) 6px,rgba(0,0,0,0.03) 7px);
    }
    .sz-open span { position:relative; z-index:1; }

    /* ─── Under-floor storage / structural ─── */
    .storage-zone {
      margin:3px; border-radius:6px;
      background:#c0c9d8;
      border:1.5px dashed #9aA4b8;
      display:flex; align-items:center; justify-content:center;
      font-family:var(--mono); font-size:0.52rem;
      color:#6a7490; text-transform:uppercase; letter-spacing:1px;
      text-align:center; line-height:1.6;
      position:relative; overflow:hidden; min-height:44px;
    }
    .storage-zone::before {
      content:''; position:absolute; inset:0;
      background:repeating-linear-gradient(45deg,transparent,transparent 8px,rgba(0,0,0,0.03) 8px,rgba(0,0,0,0.03) 9px);
    }
    .storage-zone span { position:relative; z-index:1; }

    /* ─── Small shaft connector (between rooms in a col) ─── */
    .mini-shaft {
      margin:3px; border-radius:5px;
      background:#a8b2c6;
      min-height:22px;
      display:flex; align-items:center; justify-content:center;
      font-family:var(--mono); font-size:0.42rem;
      color:#6070878; letter-spacing:0.5px; text-transform:uppercase;
      position:relative; overflow:hidden;
    }
    .mini-shaft::before {
      content:''; position:absolute; inset:0;
      background:repeating-linear-gradient(90deg,transparent,transparent 3px,rgba(255,255,255,0.1) 3px,rgba(255,255,255,0.1) 4px);
    }
    .mini-shaft span { position:relative; z-index:1; color:#5a6680; font-size:0.42rem; }

    /* ─── East wing container ─── */
    .east-wing-col {
      display:flex; flex-direction:column;
      margin:3px; gap:3px;
    }
    .east-wing-col .room { margin:0; flex:1; min-height:0; }
    .east-wing-col .stair-block { margin:0; min-height:38px; flex-shrink:0; }
    .east-wing-col .room.open-area-room {
      background:#cdd5e4; border-style:dashed;
      flex:0.7;
    }

    /* ─── Legend ─── */
    .legend { display:flex; gap:16px; margin-top:12px; flex-wrap:wrap; }
    .leg { display:flex; align-items:center; gap:6px; font-family:var(--mono); font-size:0.6rem; color:rgba(255,255,255,0.4); }
    .leg-box { width:12px; height:12px; border-radius:3px; }
    .leg-box.occ  { background:#fff; border:2px solid var(--accent); }
    .leg-box.emp  { background:var(--empty-room); border:1.5px solid var(--empty-border); opacity:0.7; }
    .leg-box.stat { background:var(--static-room); border:1.5px solid var(--static-border); }

    /* ─── Modal ─── */
    .overlay {
      position:fixed; inset:0;
      background:rgba(10,15,28,0.55); backdrop-filter:blur(5px);
      z-index:300; display:none; align-items:center; justify-content:center; padding:20px;
    }
    .overlay.open { display:flex; }
    .modal {
      background:#fff; border-radius:16px; padding:26px;
      max-width:370px; width:100%;
      box-shadow:0 24px 60px rgba(0,0,0,0.22);
      animation:mIn .22s cubic-bezier(.34,1.56,.64,1);
    }
    @keyframes mIn { from{opacity:0;transform:scale(.9) translateY(8px)} to{opacity:1;transform:scale(1)} }
    .modal-head { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px; }
    .m-room { font-family:var(--mono); font-size:2rem; font-weight:600; color:var(--accent); line-height:1; }
    .m-sub  { font-size:0.72rem; color:var(--muted); margin-top:3px; }
    .m-close {
      background:#f0f3f8; border:none; width:28px; height:28px;
      border-radius:50%; cursor:pointer; font-size:0.85rem; color:var(--muted);
      display:flex; align-items:center; justify-content:center;
    }
    .m-close:hover { background:#e2e6ef; }
    .m-hr { border:none; border-top:1px solid #e5e8f0; margin-bottom:16px; }
    .m-list { display:flex; flex-direction:column; gap:10px; }
    .m-row  { display:flex; align-items:center; gap:10px; }
    .m-av {
      width:36px; height:36px; border-radius:9px;
      background:linear-gradient(135deg,var(--accent),var(--accent2));
      display:flex; align-items:center; justify-content:center;
      font-family:var(--mono); font-size:0.75rem; font-weight:600; color:#fff; flex-shrink:0;
    }
    .m-name { font-weight:700; font-size:0.88rem; }
    .m-time { font-family:var(--mono); font-size:0.63rem; color:var(--muted); margin-top:1px; }
    .m-empty { text-align:center; padding:20px 0; color:var(--muted); font-size:0.83rem; }
    .m-empty-ico { font-size:1.8rem; display:block; margin-bottom:7px; }

    /* ─── Find-a-Person Search Bar ─── */
    .search-bar-wrap {
      display:flex; align-items:center; gap:8px;
      background:#f4f6fb; border:1.5px solid #dde3ef;
      border-radius:10px; padding:5px 10px 5px 14px;
      transition:border-color .2s, box-shadow .2s;
      position:relative; flex:1; max-width:320px;
    }
    .search-bar-wrap:focus-within {
      border-color:var(--accent); box-shadow:0 0 0 3px rgba(37,99,235,0.1);
      background:#fff;
    }
    .search-icon { font-size:0.85rem; color:var(--muted); flex-shrink:0; }
    .search-input {
      border:none; background:transparent; outline:none;
      font-family:var(--mono); font-size:0.75rem; color:var(--text);
      width:100%; min-width:0;
    }
    .search-input::placeholder { color:#aab4c8; }
    .search-clear {
      border:none; background:none; cursor:pointer;
      color:#aab4c8; font-size:0.9rem; padding:0 2px; flex-shrink:0;
      line-height:1; display:none;
    }
    .search-clear.visible { display:block; }
    .search-clear:hover { color:var(--red); }

    /* Dropdown suggestions */
    .search-dropdown {
      position:absolute; top:calc(100% + 6px); left:0; right:0;
      background:#fff; border:1.5px solid #dde3ef; border-radius:10px;
      box-shadow:0 8px 30px rgba(0,0,0,0.12);
      z-index:500; overflow:hidden; display:none;
    }
    .search-dropdown.open { display:block; }
    .sd-item {
      display:flex; align-items:center; gap:10px;
      padding:9px 14px; cursor:pointer;
      transition:background .12s; border-bottom:1px solid #f0f3f8;
    }
    .sd-item:last-child { border-bottom:none; }
    .sd-item:hover { background:#f0f5ff; }
    .sd-av {
      width:28px; height:28px; border-radius:7px; flex-shrink:0;
      background:linear-gradient(135deg,var(--accent),var(--accent2));
      display:flex; align-items:center; justify-content:center;
      font-family:var(--mono); font-size:0.62rem; font-weight:700; color:#fff;
    }
    .sd-info { flex:1; min-width:0; }
    .sd-name { font-weight:700; font-size:0.8rem; color:var(--text);
               white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sd-room { font-family:var(--mono); font-size:0.62rem; color:var(--accent); margin-top:1px; }
    .sd-time { font-family:var(--mono); font-size:0.6rem; color:var(--muted); flex-shrink:0; }
    .sd-empty {
      padding:14px; text-align:center;
      font-family:var(--mono); font-size:0.72rem; color:var(--muted);
    }

    /* Found-person result banner (below search bar) */
    .search-result-banner {
      position:absolute; top:calc(100% + 6px); left:0; right:0;
      border-radius:10px; padding:10px 14px;
      display:none; align-items:center; gap:10px;
      font-family:var(--mono); font-size:0.72rem; z-index:500;
    }
    .search-result-banner.found {
      display:flex; background:#eff6ff; border:1.5px solid #bfdbfe; color:var(--accent);
    }
    .search-result-banner.notfound {
      display:flex; background:#fff5f5; border:1.5px solid #fecaca; color:var(--red);
    }
    .srb-icon { font-size:1.1rem; flex-shrink:0; }
    .srb-text { flex:1; line-height:1.4; }
    .srb-goto {
      background:var(--accent); color:#fff; border:none; border-radius:6px;
      padding:4px 10px; font-family:var(--mono); font-size:0.65rem; font-weight:600;
      cursor:pointer; white-space:nowrap; flex-shrink:0;
    }
    .srb-goto:hover { opacity:0.85; }

    /* Room highlight pulse — added by JS when a room is found */
    @keyframes roomPulse {
      0%   { box-shadow: 0 0 0 0   rgba(37,99,235,0.7), 0 0 0 0   rgba(37,99,235,0.4); }
      50%  { box-shadow: 0 0 0 8px rgba(37,99,235,0.2), 0 0 0 16px rgba(37,99,235,0.08); }
      100% { box-shadow: 0 0 0 0   rgba(37,99,235,0);   0 0 0 0   rgba(37,99,235,0); }
    }
    .room-highlight {
      animation: roomPulse 1s ease-out infinite;
      border-color: var(--accent) !important;
      outline: 2.5px solid var(--accent);
      z-index: 20;
    }

    @media(max-width:700px) {
      .fp-wrapper { padding:10px 6px; }
      .building { padding:10px; }
      .fp { grid-template-columns: 34px 1fr 1fr 28px 1fr 1fr 1fr 1fr 1fr 8px 1fr; }
      .room { min-height:56px; padding:5px 4px; }
      .room-num { font-size:0.75rem; }
      .search-bar-wrap { max-width:100%; }
    }
  </style>
</head>
<body>

<!-- ── Navbar ── -->
<nav class="navbar">
  <div class="logo">Indoor<span>Locate</span></div>
  <div class="nav-right">
    <div class="live-pill">
      <div class="live-dot" id="liveDot"></div>
      <span id="liveText">LIVE</span>
    </div>
    <button class="nav-btn" onclick="location.href='/'">← Home</button>
